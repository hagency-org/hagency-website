---
import { b, t, url, type Locale } from '@/data/site';
import { architectureUI as copy, architectureViews, components, connections } from '@/data/architecture';
import { registrationSteps, registrationExample, transportRows, clientSteps, runtimeRows, authorityRows, storageRows, architectureSources } from '@/data/architecture-content';
import ArchitectureFlow from './ArchitectureFlow';
import Code from './Code.astro';
import Icon from './Icon.astro';
import '@xyflow/react/dist/style.css';
import '@/styles/architecture.css';
interface Props { lang: Locale }
const { lang } = Astro.props;
const sections = [
  ['map',b('Interactive map','交互架构图')],['transport',b('Fleet transport','机群传输')],['registration',b('Appservice registration','Appservice 注册')],['client',b('Robrix connection','Robrix 连接')],['runtimes',b('Coding agents','编程 Agent')],['authority',b('Identity & permissions','身份与权限')],['storage',b('State & federation','状态与联邦')],['connections',b('Connection reference','连接参考')],['architecture-sources',b('Sources','来源')],
] as const;
---
<section class="page-hero architecture-hero"><div class="container"><div class="breadcrumb"><a href={url(lang)}>Hagency</a><span>/</span><span>{t(b('Architecture','系统架构'),lang)}</span></div><span class="eyebrow">{t(copy.label,lang)}</span><h1>{t(copy.title,lang)}</h1><p>{t(copy.intro,lang)}</p><div class="architecture-badges"><span>Matrix</span><span>HTTPS</span><span>Appservice</span><span>ACP / MCP</span></div></div></section>
<nav class="container architecture-index" aria-label={t(b('Architecture sections','架构章节'),lang)}>{sections.map(([id,label])=><a href={`#${id}`}>{t(label,lang)}</a>)}</nav>
<section class="section section-tight container" id="map" aria-label={t(b('Architecture explorer','架构浏览器'),lang)}>
  <div class="architecture-snapshot"><span class="status-dot"></span>{t(copy.snapshot,lang)}</div>
  <ArchitectureFlow lang={lang} client:only="react"><div slot="fallback" class="architecture-fallback"><Icon name="network" size={38}/><p>{t(copy.fallback,lang)}</p><a class="text-link" href="#connections">{t(copy.textView,lang)}<Icon size={16}/></a></div></ArchitectureFlow>
  <p class="architecture-disclosure">{t(copy.scope,lang)}</p>
</section>

<section class="section container border-top architecture-detail" id="transport"><div class="section-header"><span class="eyebrow">01 / HTTPS</span><h2>{t(b('Hagency connects out.\nPalpo keeps the queue.','Hagency 主动连接，\nPalpo 持久保存队列。'),lang)}</h2><p>{t(b('The contributor machine can stay behind NAT. Hagency’s bridge initiates HTTPS connections to the public Palpo web transport; the Matrix homeserver reaches a colocated relay on the server network.','贡献方机器可以位于 NAT 后。Hagency 桥接主动向公开的 Palpo Web 传输入口发起 HTTPS 连接；Matrix homeserver 则通过服务器网络访问同侧中继。'),lang)}</p></div>
  <div class="architecture-table-wrap" tabindex="0" role="region" aria-label={t(b('Outbound transport API reference','出站传输 API 参考'),lang)}><table class="architecture-table"><thead><tr>{[b('Operation / API','操作 / API'),b('Direction','方向'),b('What it means','含义')].map(h=><th scope="col">{t(h,lang)}</th>)}</tr></thead><tbody>{transportRows.map(row=><tr><th scope="row"><strong>{t(row.operation,lang)}</strong><code>{row.api}</code></th><td>{t(row.direction,lang)}</td><td>{t(row.meaning,lang)}</td></tr>)}</tbody></table></div>
  <div class="architecture-note-grid"><article><h3>{t(b('Durability, with explicit states','持久投递，状态明确'),lang)}</h3><p>{t(b('The web relay persists before acknowledging Matrix. Hagency persists before acknowledging a delivery lease. Replayed IDs and content digests prevent duplicate admissions; conflicting payloads are refused. Processing, allocation and completion remain separate from both acknowledgments.','Web 中继先持久化，再向 Matrix 确认；Hagency 先持久化，再确认投递租约。重放 ID 和内容摘要用于防止重复接纳，冲突内容会被拒绝。处理、分配和完成状态与这两种确认分别记录。'),lang)}</p></article><article><h3>{t(b('Connection proof, then heartbeats','先验证连接，再以心跳维持'),lang)}</h3><p>{t(b('The exact current-generation Matrix probe establishes the connection. Background heartbeats maintain liveness afterwards. A stale request observation cannot become “ready now” merely because a heartbeat or retransmission arrived later. Existing callback fleets need an explicit migration; the map shows the current outbound path.','当前 generation 的确切 Matrix 探测建立连接，之后由后台心跳维持活性。旧申请观察不会因为较晚到达的心跳或重传而变成“当前就绪”。已有回调机群需要明确迁移，图中展示当前出站路径。'),lang)}</p></article></div>
</section>

<section class="section container border-top architecture-detail" id="registration"><div class="section-header"><span class="eyebrow">02 / APPSERVICE</span><h2>{t(b('Register the service.\nThen verify the connection.','注册服务，\n再验证连接。'),lang)}</h2><p>{t(b('Matrix defines an application service registration. Palpo’s companion web app automates its installation and adds owner pairing and fleet transport around it.','Matrix 定义应用服务注册；Palpo 配套 Web 应用自动安装注册，并在其周围实现所有者配对和机群传输。'),lang)}</p></div>
  <ol class="architecture-steps">{registrationSteps.map((step,index)=><li><span class="architecture-step-number">{String(index+1).padStart(2,'0')}</span><div><h3>{t(step.title,lang)}</h3><p>{t(step.body,lang)}</p></div></li>)}</ol>
  <details class="architecture-example"><summary>{t(b('Inspect an illustrative Appservice registration','查看 Appservice 注册示例'),lang)}<Icon name="down" size={18}/></summary><Code lang={lang} label={t(b('Example only · generated per fleet · no real secrets','仅作示例 · 每个机群独立生成 · 不含真实密钥'),lang)} code={registrationExample}/><p>{t(b('The relay URL is reachable by the homeserver. The local-user regular expression is anchored to one fleet and one Matrix server identity. This YAML illustrates fields; the companion service installs their JSON equivalent through Palpo’s admin API.','中继 URL 供 homeserver 访问；本地用户正则限定到一个机群和一个 Matrix 服务器身份。这段 YAML 展示字段，配套服务通过 Palpo 管理 API 安装等价 JSON。'),lang)}</p></details>
</section>

<section class="section container border-top architecture-detail" id="client"><div class="section-header"><span class="eyebrow">03 / ROBRIX2 → PALPO</span><h2>{t(b('A native client.\nA standard Matrix connection.','原生客户端，\n标准 Matrix 连接。'),lang)}</h2><p>{t(b('Robrix connects to the Matrix homeserver directly. Its conversations reach Hagency through Matrix events, room bindings, and the bridge.','Robrix 直接连接 Matrix homeserver，其对话通过 Matrix 事件、房间绑定和桥接到达 Hagency。'),lang)}</p></div><div class="architecture-note-grid">{clientSteps.map(step=><article><h3>{t(step.title,lang)}</h3><p>{t(step.body,lang)}</p></article>)}</div>
  <p class="architecture-callout">{t(b('A room’s power levels can grant a person and an agent the same room capabilities. Coding-tool execution still requires Hagency’s own runtime authorization.','房间权限等级可以赋予人和 Agent 相同的房间能力，但编程工具执行仍需 Hagency 自身的运行时授权。'),lang)} <a href={url(lang,'matrix')}>{t(b('Explore Matrix’s permission model','了解 Matrix 权限模型'),lang)} →</a></p>
</section>

<section class="section container border-top architecture-detail" id="runtimes"><div class="section-header"><span class="eyebrow">04 / HAGENCY → CODING AGENTS</span><h2>{t(b('One control plane.\nSeveral explicit runtime paths.','一个控制平面，\n多条明确的运行路径。'),lang)}</h2><p>{t(b('Hagency coordinates real coding-agent processes. It rebuilds context, chooses an eligible adapter, grants scoped tools, observes execution, and routes the result back to the originating conversation.','Hagency 协调真实编程 Agent 进程，重建上下文、选择符合条件的适配器、授予限定范围工具、观察执行，并将结果送回原始会话。'),lang)}</p></div>
  <div class="architecture-runtime-grid">{runtimeRows.map(row=><article class="architecture-runtime-card"><div class="architecture-runtime-heading"><h3>{row.name}</h3><span>{t(row.kind,lang)}</span></div><code>{row.transport}</code><p>{t(row.flow,lang)}</p><p class="runtime-boundary">{t(row.limits,lang)}</p></article>)}</div>
  <div class="architecture-note-grid" style="margin-top:35px"><article><h3>{t(b('ACP, MCP and inference do different jobs','ACP、MCP 与推理各司其职'),lang)}</h3><p>{t(b('ACP is the session protocol between Hagency and compatible coding adapters. MCP exposes Hagency tools to the coding agent. The agent separately contacts its configured model provider. Octos’s config-based MCP injection and Hermes/Codex ACP session injection are deliberate adapter differences.','ACP 是 Hagency 与兼容编程适配器之间的会话协议；MCP 向编程 Agent 提供 Hagency 工具；Agent 再独立连接其配置的模型服务。Octos 基于自身配置注入 MCP，Hermes/Codex ACP 基于会话注入，这是明确的适配器差异。'),lang)}</p></article><article><h3>{t(b('Durable sessions, disposable workers','会话持久，工作进程可替换'),lang)}</h3><p>{t(b('The backend owns agent + room + scope + thread identity, accepted inputs, summaries and dispatch state. A fresh worker receives bounded rebuilt context. Coding work requires a task and real Matrix thread root. Retained tmux panes and runtime process IDs do not replace that authority.','后端拥有 Agent、房间、范围和线程身份，以及已接纳输入、摘要和调度状态。新工作进程接收有界重建上下文；编程工作需要任务和真实 Matrix 线程根。保留的 tmux 窗格及运行时进程 ID 不能替代这一权威状态。'),lang)}</p></article></div>
</section>

<section class="section container border-top architecture-detail" id="authority"><div class="section-header"><span class="eyebrow">05 / IDENTITY & AUTHORITY</span><h2>{t(b('Every connection has its own authority.','每条连接，都有自己的权限来源。'),lang)}</h2><p>{t(b('The same room permission model can apply to people and agents. The credentials below serve different network and execution boundaries.','人与 Agent 可以使用相同的房间权限模型。以下凭据则分别对应不同网络与执行边界。'),lang)}</p></div><div class="architecture-table-wrap" tabindex="0" role="region" aria-label={t(b('Credential directions and authority','凭据方向与权限'),lang)}><table class="architecture-table"><thead><tr>{[b('Credential','凭据'),b('Caller → service','调用方 → 服务'),b('Scope','范围')].map(h=><th scope="col">{t(h,lang)}</th>)}</tr></thead><tbody>{authorityRows.map(([name,direction,scope])=><tr><th scope="row"><code>{name}</code></th><td>{t(direction,lang)}</td><td>{t(scope,lang)}</td></tr>)}</tbody></table></div></section>

<section class="section container border-top architecture-detail" id="storage"><div class="section-header"><span class="eyebrow">06 / STATE & FEDERATION</span><h2>{t(b('State lives where its responsibility lives.','状态跟随责任，分别保存。'),lang)}</h2></div><div class="architecture-storage-grid">{storageRows.map(row=><article><h3>{typeof row.name==='string'?row.name:t(row.name,lang)}</h3><p>{t(row.body,lang)}</p></article>)}</div><div class="architecture-callout"><h3>{t(b('Federation connects independently operated rooms','联邦连接独立运营的房间'),lang)}</h3><p>{t(b('A person on another homeserver can participate in an authorized federated room. Their server exchanges room events with Palpo using the Matrix Server–Server API. This does not expose Hagency’s local API or share its filesystem. Room data, encryption availability and model-provider disclosure still depend on the actual room, devices and deployment.','其他 homeserver 上的用户可以参与获授权的联邦房间。其服务器使用 Matrix 服务器间 API 与 Palpo 交换房间事件。这不会暴露 Hagency 本地 API 或共享其文件系统。房间数据、加密可用性及模型服务的数据披露仍取决于实际房间、设备与部署。'),lang)}</p></div></section>

<section class="section container border-top architecture-detail" id="connections"><div class="section-header"><span class="eyebrow">07 / CONNECTION REFERENCE</span><h2>{t(b('Read the map, connection by connection.','逐条阅读系统连接。'),lang)}</h2><p>{t(b('The same connections as the interactive diagram, readable without JavaScript. Arrows identify the caller and recipient; a poll’s response carries deliveries back to Hagency.','与交互图对应的连接说明，无需 JavaScript 即可阅读。箭头标识调用方与接收方，轮询响应则将投递内容返回 Hagency。'),lang)}</p></div>{architectureViews.map((view,index)=><details class="architecture-reference" open={index===0}><summary>{t(view.title,lang)}<Icon name="down" size={18}/></summary><div class="architecture-connection-list">{view.edges.map(id=>{const edge=connections.find(item=>item.id===id)!;return <article><h3>{t(components[edge.from].title,lang)} → {t(components[edge.to].title,lang)}</h3><code>{edge.protocol}</code><p>{t(edge.detail,lang)}</p></article>;})}</div></details>)}</section>

<section class="section container border-top architecture-detail" id="architecture-sources"><div class="section-header"><span class="eyebrow">08 / SOURCE NOTES</span><h2>{t(b('Grounded in the implementation.','以实际实现为依据。'),lang)}</h2><p>{t(b('Reviewed September 2026 local development sources. The repository links identify upstream projects; these local revisions and integrations are not asserted to be the latest published releases or the exact currently deployed binary.','核验于 2026 年 9 月的本地开发源码。仓库链接指向上游项目，不将这些本地版本与集成等同于最新发布版或当前部署二进制。'),lang)}</p></div><div class="architecture-source-grid">{architectureSources.map(source=><article><a href={source.url} target="_blank" rel="noopener noreferrer">{t(source.title,lang)}<Icon name="external" size={15}/></a><p>{t(source.note,lang)}</p></article>)}</div><p class="architecture-disclosure">{t(b('The fleet /api/fleet/v2 transport, Palpo admin registration endpoint and companion app are project extensions. Standard Matrix supplies client/server communication, Appservices, room permissions and federation.','机群 /api/fleet/v2 传输、Palpo 管理注册入口与配套应用属于项目扩展；标准 Matrix 提供客户端服务器通信、Appservice、房间权限和联邦。'),lang)}</p></section>
