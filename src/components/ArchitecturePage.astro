---
import {b,t,url,type Locale} from '@/data/site';
import {architectureUI as copy,architectureViews,components,connections} from '@/data/architecture';
import audit from '@/data/capabilities.json';
import ArchitectureFlow from './ArchitectureFlow';
import Icon from './Icon.astro';
import '@xyflow/react/dist/style.css';
import '@/styles/architecture.css';
interface Props {lang:Locale}
const {lang}=Astro.props;
---
<section class="page-hero architecture-hero"><div class="container"><span class="eyebrow">{t(copy.label,lang)}</span><h1>{t(copy.title,lang)}</h1><p>{t(copy.intro,lang)}</p><div class="architecture-badges"><span>Matrix</span><span>OAuth / PKCE</span><span>Codex · Claude · Octos OUP</span></div></div></section>
<section class="section container" id="map" aria-label={t(b('Architecture explorer','架构浏览器'),lang)}><div class="architecture-snapshot">{t(copy.snapshot,lang)}</div><ArchitectureFlow lang={lang} client:only="react"><div slot="fallback" class="architecture-fallback"><Icon name="network" size={38}/><p>{t(copy.fallback,lang)}</p><a class="text-link" href="#connections">{t(copy.textView,lang)}</a></div></ArchitectureFlow><p class="architecture-disclosure">{t(copy.scope,lang)}</p></section>
<section class="section container border-top" id="registration"><div class="section-header"><h2>{t(b('Start with one personal Agent.','从一个个人 Agent 开始。'),lang)}</h2></div><ol class="architecture-steps">{[
[b('Install a published Desktop package and sign in through Pasion.','安装已发布 Desktop，通过 Pasion 登录。'),b('Desktop publishes and discovers device keys for encrypted conversations.','Desktop 为加密对话发布并发现设备密钥。')],
[b('Host this account on the execution computer, then add a local Agent and choose its runtime/profile.','先在执行电脑托管当前账户，再添加本地 Agent 并选择运行时与配置。'),b('A Project is not required. Credentials stay with the local runtime.','无需 Project，凭据由本地运行时保管。')],
[b('Send a clear task in the private conversation.','在私聊中发送明确任务。'),b('For a bound group room, use an explicit mention and keep follow-ups in the same thread.','绑定群聊后明确提及 Agent，在相同线程继续。')],
[b('Review supported permissions and inspect the result.','审核支持的权限并检查结果。'),b('Stopping or revoking supply blocks new work; retained usage and receipts still need reconciliation.','停止或撤销供给会阻断新任务，保留用量与回执仍需对账。')]
].map(([title,body],i)=><li><span class="architecture-step-number">0{i+1}</span><div><h3>{t(title,lang)}</h3><p>{t(body,lang)}</p></div></li>)}</ol><a class="text-link" href={url(lang,'docs/request-agent')}>{t(b('Follow the current setup guide','遵循当前配置指南'),lang)} →</a></section>
<section class="section container border-top" id="runtimes"><div class="section-header"><h2>{t(b('Each runtime has its own boundary.','每种运行时都有自己的边界。'),lang)}</h2></div><div class="architecture-runtime-grid">{(['codex','claude','octos'] as const).map(id=><article class="architecture-runtime-card"><h3>{t(components[id].title,lang)}</h3><code>{components[id].interfaces[0]}</code><p>{t(components[id].body,lang)}</p><p class="runtime-boundary">{t(components[id].boundary,lang)}</p></article>)}</div></section>
<section class="section container border-top" id="connections"><div class="section-header"><h2>{t(b('Every connection, readable without JavaScript.','每条连接，无需 JavaScript 即可阅读。'),lang)}</h2></div>{architectureViews.map((view,i)=><details class="architecture-reference" open={i===0}><summary>{t(view.title,lang)}<Icon name="down" size={18}/></summary><div class="architecture-connection-list">{view.edges.map(id=>{const edge=connections.find(e=>e.id===id)!;return <article><h3>{t(components[edge.from].title,lang)} → {t(components[edge.to].title,lang)}</h3><code>{edge.protocol}</code><p>{t(edge.detail,lang)}</p></article>})}</div></details>)}</section>
<section class="section container border-top" id="architecture-sources"><div class="section-header"><h2>{t(b('Explore the implementation.','了解开源实现。'),lang)}</h2><p>{t(b('Read the Desktop and Server code, explore the architecture and find the right configuration for your team.','阅读 Desktop 与 Server 源码，了解系统架构，选择适合团队的配置。'),lang)}</p></div><div class="source-list">{Object.entries(audit.pins).filter(([id])=>id==='desktop'||id==='server').map(([id,p])=><a href={`https://github.com/${p.repository}/tree/${p.commit}`} target="_blank" rel="noopener noreferrer">{id} · {p.commit.slice(0,8)}</a>)}<a href={url(lang,'capabilities')}>{t(b('Explore features','了解产品功能'),lang)}</a></div></section>
