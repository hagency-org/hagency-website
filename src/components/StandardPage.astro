---
import {b,t,ui,projects,paths,repos,url,asset,type Locale} from '@/data/site';
import {guides,articles,pageInfo,trustSections} from '@/data/content';
import releases from '@/data/releases.json';
import Icon from './Icon.astro';
import Architecture from './Architecture.astro';
import Workflow from './Workflow.astro';
import ScreenshotGallery from './ScreenshotGallery.astro';
import ProjectScreenshot from './ProjectScreenshot.astro';
import {archivedScreenshots} from '@/data/screenshots';
interface Props {lang:Locale;slug:Exclude<keyof typeof pageInfo,''|'matrix'|'architecture'>}
const {lang,slug}=Astro.props; const info=pageInfo[slug];
const date=(v:string)=>new Intl.DateTimeFormat(lang==='en'?'en-US':'zh-CN',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}).format(new Date(v));
const platformNames:Record<string,string>={macos:'macOS',windows:'Windows',linux:'Linux',android:'Android',ios:'iOS'};
const notes:Record<string,{title:ReturnType<typeof b>;body:ReturnType<typeof b>;href:string}[]>={
 'use-cases':[
 {title:b('Your first coding Agent','你的第一个编程 Agent'),body:b('Create a personal Agent, choose a local Codex, Claude or Octos configuration, and start in its private chat. Add a group room when you need shared work.','创建个人 Agent，选择本地 Codex、Claude 或 Octos 配置，在私聊中开始；需要协作时再绑定群聊。'),href:'docs/request-agent'},
 {title:b('Share capacity with an explicit decision','通过明确审批共享容量'),body:b('An applicant requests an Agent from a pool with a positive token ceiling. The resource owner reviews it, and a qualified executor must be online before work starts.','申请人选择资源池、填写 Agent 名称和正数 token 上限；资源所有者审核，通过后还需合格执行器在线。'),href:'docs/resource-pools'},
 {title:b('Operate your own service','运营自己的服务'),body:b('Hagency Server integrates Palpo, Pasion and management in one Rust process. Configure its public origin, PostgreSQL databases, backups and executor policy.','Hagency Server 在一个 Rust 进程内集成 Palpo、Pasion 和管理界面；配置公开地址、PostgreSQL 数据库、备份与执行策略。'),href:'docs/deploy-palpo'}],
 roadmap:[
 {title:b('Published now','当前已发布'),body:b('Desktop rc.13 has macOS ARM64 and Windows x86-64 installers. Standalone Palpo is v0.6.0. Server is distributed as source and CI-built container images.','Desktop rc.13 提供 macOS ARM64 与 Windows x86-64 安装包；独立 Palpo 为 v0.6.0；Server 提供源码和 CI 构建的容器镜像。'),href:'downloads'},
 {title:b('Newer main changes','较新的 main 修改'),body:b('The reviewed Desktop main is preparing rc.14, with later Windows setup, permission feedback, room restoration and multi-account owner-daemon changes. Check the exact source pin before relying on them.','核验的 Desktop main 正准备 rc.14，包含较新的 Windows 配置、权限反馈、房间恢复与多账户所有者守护进程修改；依赖这些功能前请核对准确版本。'),href:'capabilities'},
 {title:b('Still needs matched acceptance','仍需对等验收'),body:b('Full autonomous post-run reports, third-party client parity and a matched Buzz task benchmark remain open acceptance work. Source support does not establish a UX score.','完整的运行结束后主动报告、第三方客户端对等体验以及与 Buzz 的相同任务基准仍需验收；源码支持不能直接证明 UX 分数。'),href:'compare'}],
 community:[
 {title:b('Report a reproducible issue','反馈可复现的问题'),body:b('Include the app version, operating system, runtime and the step that failed. Remove tokens, private room content and device secrets.','请附上应用版本、操作系统、运行时及失败步骤，并移除令牌、私密房间内容和设备密钥。'),href:'docs/operations'},
 {title:b('Contribute where the feature lives','到对应功能仓库贡献'),body:b('Desktop owns native interaction and local execution; Server owns identity integration and management; Palpo owns the Matrix foundation. Repository links below take you to the maintainers.','Desktop 负责原生交互与本地执行；Server 负责身份集成与管理；Palpo 负责 Matrix 基础。下方仓库链接通往相应维护者。'),href:'ecosystem'}],
 about:[
 {title:b('People direct the work','由人指引工作'),body:b('Hagency connects local coding agents to Matrix conversations. Agent ownership, room membership and tool permissions remain explicit, separate decisions.','Hagency 将本地编程 Agent 接入 Matrix 对话；Agent 所有权、房间成员关系和工具权限分别由明确决策管理。'),href:'architecture'},
 {title:b('Open source, with inspectable limits','开源，也说明边界'),body:b('This site is checked against pinned Desktop and Server sources. Release availability, source review, automated checks and real-stack evidence are listed separately.','本站依据固定版本的 Desktop 与 Server 源码核验，分别列出发布可用性、源码检查、自动测试和真实链路证据。'),href:'capabilities'}]
};
---
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href={url(lang)}>Hagency</a><span>/</span><span>{t(info.title,lang)}</span></div><span class="eyebrow" style="display:block;margin-top:36px">{t(ui.lastVerified,lang)}</span><h1>{t(info.title,lang)}</h1><p>{t(info.description,lang)}</p></div></section>
{slug==='ecosystem' && <section class="section container"><Architecture lang={lang} detailed/><div class="card-grid" style="margin-top:40px">{projects.map(p=><a class:list={['card',p.color]} href={url(lang,`projects/${p.id}`)}><span class="eyebrow">{t(p.role,lang)}</span><h2>{p.name}</h2><p>{t(p.description,lang)}</p><span class="text-link">{t(ui.learn,lang)}<Icon size={16}/></span></a>)}</div><aside class="notice"><strong>{t(b('Two applications, one Matrix foundation','两个应用，一个 Matrix 基础'),lang)}</strong>{t(b('Desktop runs the local owner engine. Server embeds Palpo and Pasion; a separate Fleet or Node companion is no longer the setup path.','Desktop 运行本地所有者引擎；Server 内嵌 Palpo 与 Pasion，不再通过独立 Fleet 或 Node 配套应用接入。'),lang)}</aside></section>}
{slug==='demo' && <section class="section container"><Workflow lang={lang}/><aside class="notice"><strong>{t(b('Guided illustration','引导示意'),lang)}</strong>{t(b('This example changes local presentation only. It does not create an Agent, send a message, grant permission or prove a successful live run.','此示例只改变本地展示，不会创建 Agent、发送消息或授予权限，也不能证明真实任务已经成功。'),lang)} <a href={url(lang,'docs/request-agent')}>{t(ui.readGuide,lang)}</a></aside></section>}
{slug==='get-started' && <section class="section container"><div class="card-grid">{paths.map(path=><a class="card" href={url(lang,path.href)}><span class="card-icon"><Icon name={path.icon} size={28}/></span><h2>{t(path.title,lang)}</h2><p>{t(path.description,lang)}</p><span class="text-link">{t(path.label,lang)}<Icon size={16}/></span></a>)}</div><div class="timeline" style="margin-top:60px">{['install-robrix2','connect-fleet','request-agent','approvals'].map((id,i)=>{const g=guides.find(g=>g.slug===id)!;return <article class="timeline-item"><span class="eyebrow">0{i+1}</span><h2>{t(g.title,lang)}</h2><p>{t(g.description,lang)}</p><a class="text-link" href={url(lang,`docs/${id}`)}>{t(ui.readGuide,lang)}<Icon size={16}/></a></article>})}</div></section>}
{slug==='docs' && <section class="section container"><div class="guide-topbar"><span class="eyebrow">{guides.length} / {t(b('CURRENT GUIDES','当前指南'),lang)}</span><button class="inline-search search-open" type="button"><Icon name="search" size={17}/>{t(ui.searchPlaceholder,lang)}<kbd>⌘ K</kbd></button></div><div class="card-grid guide-grid">{guides.map((g,i)=><a class="card" href={url(lang,`docs/${g.slug}`)}><span class="card-number">{String(i+1).padStart(2,'0')}</span><h2>{t(g.title,lang)}</h2><p>{t(g.description,lang)}</p><span class="text-link">{t(ui.readGuide,lang)}<Icon size={16}/></span></a>)}</div></section>}
{slug==='downloads' && <section class="section container"><aside class="notice"><strong>{t(b('Desktop: choose an available installer','Desktop：选择实际提供的安装包'),lang)}</strong>{t(b('rc.13 publishes macOS ARM64 and Windows x86-64 only. Linux, Intel Mac and mobile packages are not published for this release. Server has no standalone release installer.','rc.13 仅发布 macOS ARM64 与 Windows x86-64 安装包；此版本未发布 Linux、Intel Mac 或移动端安装包。Server 没有独立发布安装器。'),lang)}</aside><div class="platform-control"><label for="platform">{t(ui.platform,lang)}</label><select id="platform" data-platform-select><option value="all">{t(ui.all,lang)}</option>{Object.entries(platformNames).map(([key,value])=><option value={key}>{value}</option>)}</select></div>{releases.releases.map(release=>{const project=projects.find(p=>p.id===release.id)!;return <article class="release-group" data-release-group><div class="release-header"><div><h2>{project.name}<span>{release.tag}</span></h2><p>{date(release.publishedAt)}</p></div><a class="text-link" href={release.source} target="_blank" rel="noopener noreferrer">{t(ui.releaseNotes,lang)}<Icon name="external" size={14}/></a></div>{release.assets.map(a=><div class="download-row" data-download-row data-platform={a.platform}><div><strong>{platformNames[a.platform]} · {a.arch}</strong><small>{a.name} · {(a.size/1048576).toFixed(1)} MB</small>{a.signature && <a class="asset-signature" href={a.signature}>{t(b('Signature','签名'),lang)}</a>}</div><a class="text-link" href={a.url} aria-label={`${t(ui.download,lang)} ${a.name}`}>{t(ui.download,lang)}<Icon name="download" size={16}/></a></div>)}<p class="platform-empty" data-platform-empty hidden={release.assets.length>0}>{t(b('No installer for this platform in this release. Check source prerequisites before choosing a source installation.','此版本没有该平台安装包；选择源码安装前请检查依赖。'),lang)} <a class="text-link" href={repos[project.id]}>{t(ui.source,lang)}</a></p>{release.checksums && <div class="download-row"><span>SHA256</span><a class="text-link" href={release.checksums}>{t(b('Checksums','校验和'),lang)}</a></div>}</article>})}<aside class="notice"><strong>Hagency Server</strong>{t(b('Use its source or CI-built container and the deployment guide. Standalone Palpo downloads are not a complete Hagency Server installation.','请使用源码或 CI 容器镜像，并遵循部署指南。单独下载 Palpo 不能得到完整的 Hagency Server。'),lang)} <a href={url(lang,'docs/deploy-palpo')}>{t(ui.readGuide,lang)}</a></aside></section>}
{slug==='security' && <section class="section container"><div class="card-grid guide-grid">{trustSections.map(item=><article class="card"><h2>{t(item.title,lang)}</h2>{item.paragraphs.map(p=><p>{t(p,lang)}</p>)}</article>)}</div><div class="button-row" style="margin-top:32px"><a class="button" href={url(lang,'docs/approvals')}>{t(b('Review permission decisions','了解权限决策'),lang)}</a><a class="button button-quiet" href={url(lang,'capabilities')}>{t(ui.capabilities,lang)}</a></div></section>}
{slug==='updates' && <section class="section container"><div class="guide-topbar"><span class="eyebrow">2026-11-19</span><a href={asset(`${lang}/rss.xml`)}>RSS</a></div><div class="card-grid">{articles.map(a=><a class="card article-card" href={url(lang,`updates/${a.slug}`)}><h2>{t(a.title,lang)}</h2><p>{t(a.description,lang)}</p><span>{date(a.date!)}</span></a>)}</div><div class="filters" data-filter-group style="margin-top:48px" aria-label={t(b('Filter releases by project','按项目筛选版本'),lang)}><button class="filter-button" data-filter="all" aria-pressed="true">{t(b('All projects','全部项目'),lang)}</button>{projects.map(p=><button class="filter-button" data-filter={p.id} aria-pressed="false">{p.name}</button>)}</div>{releases.releases.map(r=><article class="release-group" data-filter-item={r.id}><h2>{projects.find(p=>p.id===r.id)!.name} {r.tag}</h2><p>{date(r.publishedAt)}</p><a class="text-link" href={r.source}>{t(ui.releaseNotes,lang)}<Icon size={16}/></a></article>)}</section>}
{slug==='media' && <section class="section container"><aside class="notice"><strong>{t(b('Capture provenance','截图来源'),lang)}</strong>{t(b('The dated November JIT fixture uses synthetic accounts and a deterministic provider. It is evidence of that test run, not a screenshot of every current release. Older September Fleet screens are retained as archived media only.','标注日期的 11 月 JIT 测试使用虚构账户与确定性提供方，只证明对应测试，不代表所有当前发布版。9 月旧 Fleet 画面仅作为历史素材保留。'),lang)}</aside><ScreenshotGallery lang={lang} project={projects.find(p=>p.id==='robrix2')!}/><details><summary>{t(b('Archived September interfaces — retired workflow','9 月历史界面：已退役流程'),lang)}</summary><div class="screenshot-gallery">{archivedScreenshots.map(screenshot=><ProjectScreenshot lang={lang} screenshot={screenshot}/>)}</div></details></section>}
{notes[slug] && <section class="section container"><div class="card-grid guide-grid">{notes[slug].map(n=><a class="card" href={url(lang,n.href)}><h2>{t(n.title,lang)}</h2><p>{t(n.body,lang)}</p><span class="text-link">{t(ui.learn,lang)}<Icon size={16}/></span></a>)}</div></section>}
{slug==='community' && <section class="section container border-top"><div class="source-list">{projects.map(p=><a href={`${repos[p.id]}/issues`} target="_blank" rel="noopener noreferrer">{p.name} / GitHub</a>)}</div></section>}
