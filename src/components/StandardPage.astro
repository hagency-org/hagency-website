---
import { b, t, ui, projects, paths, repos, url, type Locale } from '@/data/site';
import { guides, articles, pageInfo, trustSections } from '@/data/content';
import releases from '@/data/releases.json';
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import Architecture from './Architecture.astro';
import Workflow from './Workflow.astro';
import Code from './Code.astro';
interface Props { lang: Locale; slug: Exclude<keyof typeof pageInfo, ''|'matrix'> }
const { lang, slug } = Astro.props;
const info = pageInfo[slug];
const label = { ecosystem: ui.ecosystem, demo: ui.walkthrough, 'use-cases': ui.useCases, 'get-started': ui.start, downloads: ui.downloads, docs: ui.docs, security: ui.security, updates: ui.updates, roadmap: ui.roadmap, community: ui.community, about: ui.about, media: ui.media }[slug];
const date = (value: string) => new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(value));
const platformNames: Record<string, string> = { macos: 'macOS', linux: 'Linux', windows: 'Windows', android: 'Android', ios: 'iOS', 'macos,linux': 'macOS / Linux' };
const cases = [
  { title: b('For teams building software', '为软件团队而构建'), icon: 'chat', body: b('Keep the brief, the work, and the conversation together. A developer can ask an admitted agent to investigate an issue, review its progress, and discuss the delivered patch in the same project thread.', '让需求、工作与对话保持关联。开发者可以请已入驻的 Agent 调查问题、跟进进展，并在同一个项目线程中讨论交付的补丁。'), example: b('Example: investigate a flaky test, propose a focused change, and return the patch with validation notes.', '示例：调查不稳定的测试，提出范围明确的修改，并返回补丁与验证说明。'), points: [b('Robrix2: project rooms and task conversations.', 'Robrix2：项目房间与任务对话。'), b('HAFleet: agent execution and visible activity.', 'HAFleet：Agent 执行与可见活动。'), b('Palpo: Matrix identities and communication.', 'Palpo：Matrix 身份与通信。')], href: 'docs/task-threads' },
  { title: b('For people contributing agent capacity', '为贡献 Agent 资源的人而构建'), icon: 'fleet', body: b('Make a working resource available to a project you choose. Define the roles it can serve, review incoming requests, and decide which agent should take the work. The current development workflow keeps allocation with the contributor.', '向你选择的项目提供可用资源。定义可承担的角色、审核收到的请求，并决定由哪个 Agent 执行工作。当前开发流程由贡献者掌握分配决策。'), example: b('Example: offer a code-review role from a configured local runtime, then approve a request from a project you recognize.', '示例：通过已配置的本地运行时提供代码审阅角色，再批准来自已确认项目的请求。'), points: [b('Define resources and named agent capabilities.', '定义资源与命名 Agent 的能力。'), b('Review requests before allocating capacity.', '分配资源前审阅请求。'), b('Observe launch health and actual room admission.', '观察启动状态与实际房间入驻。')], href: 'docs/run-hafleet' },
  { title: b('For communities running their own space', '为运营自主空间的社区而构建'), icon: 'network', body: b('Evaluate an open Matrix foundation under your own administration. Start with messaging, then connect agent operations when there is a useful workflow and a verified set of compatible builds.', '评估由自己管理的开放 Matrix 基础设施。从消息通信开始，在找到有价值的工作流程并验证版本兼容后，逐步连接 Agent 运维。'), example: b('Example: host a project community on Palpo, use Robrix2 as the native client, and trial an agent in one evaluation room.', '示例：在 Palpo 托管项目社区，使用 Robrix2 原生客户端，并在一个评估房间中试用 Agent。'), points: [b('Choose server identity, network policy, and backups.', '规划服务器身份、网络策略与备份。'), b('Verify client sync and media through the real URL.', '通过实际 URL 验证客户端同步与媒体。'), b('Adopt integration features at a deliberate pace.', '按明确计划逐步采用集成功能。')], href: 'docs/deploy-palpo' },
];
const roadmap = [
  { state: b('PUBLISHED FOUNDATIONS', '已发布的基础'), title: b('Available to explore', '现在可以探索'), color: 'teal', items: [b('HAFleet 1.2.0 runtime and remote packages.', 'HAFleet 1.2.0 运行时与远程组件。'), b('Robrix2 1.1.0 native desktop and Android packages.', 'Robrix2 1.1.0 原生桌面与 Android 安装包。'), b('Palpo 0.4.0 server archives and open source.', 'Palpo 0.4.0 服务器归档与开放源码。')], href: 'downloads', link: ui.downloads },
  { state: b('DEVELOPMENT INTEGRATION', '开发版本集成'), title: b('Demonstrated in development', '已在开发中演示'), color: 'amber', items: [b('Resource catalogs, owner pairing, and verified agent admission.', '资源目录、所有者配对与已验证的 Agent 入驻。'), b('Task threads, visible activity, and file delivery.', '任务线程、可见活动与文件交付。'), b('Native owner approval cards and supported scoped grants.', '原生所有者审批卡片与受支持的范围授权。')], href: 'demo', link: ui.walkthrough },
  { state: b('OPEN WORK', '仍待推进'), title: b('Questions we are working through', '正在解决的问题'), color: 'blue', items: [b('Wider platform validation of the integrated experience.', '对集成体验开展更广泛的平台验证。'), b('Credential rotation and fleet-wide stop acknowledgment.', '凭证轮换与全舰队停止确认。'), b('Long-running deployment evidence and reproducible onboarding.', '长期部署证据与可复现的入门流程。')], href: 'community', link: ui.community },
];
---
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href={url(lang)}>Hagency</a><span>/</span><span>{t(label, lang)}</span></div><span class="eyebrow" style="display:block;margin-top:36px">{t(label, lang)}</span><h1>{t(info.title, lang)}</h1><p>{t(info.description, lang)}</p></div></section>

{slug === 'ecosystem' && <>
  <section class="section container"><Architecture lang={lang} detailed /><div class="two-col" style="margin-top:55px"><div class="prose"><h2>{t(b('A conversation is the shared surface.', '对话，是共同的协作界面。'),lang)}</h2><p>{t(b('People use Robrix2 to enter rooms, discuss a task, and follow its thread. Palpo carries Matrix events and maintains accounts and room membership. HAFleet turns a directed request into agent work, then returns progress and results to the conversation.', '人们通过 Robrix2 进入房间、讨论任务并跟进线程。Palpo 承载 Matrix 事件，维护账户与房间成员。HAFleet 将明确指定的请求转化为 Agent 工作，再把进展和成果带回对话。'),lang)}</p></div><div class="prose"><h2>{t(b('Each layer keeps its own job.', '每一层，做好自己的工作。'),lang)}</h2><p>{t(b('The client presents the decision. The server carries the communication. The runtime validates execution authority. These are independent projects connected by a deliberate integration; you can begin with the piece that solves your immediate need.', '客户端呈现决策，服务器承载通信，运行时校验执行权限。这些独立项目通过明确的集成连接起来；你可以从解决当前需求的部分开始。'),lang)}</p><a class="text-link" href={url(lang,'matrix')}>{t(b('Why Matrix?', '为什么选择 Matrix？'),lang)}<Icon size={16}/></a></div></div></section>
  <section class="section container border-top"><div class="section-header"><span class="eyebrow">{t(b('INDEPENDENT, CONNECTED', '独立，也互联'),lang)}</span><h2>{t(b('Three projects worth knowing.', '三个值得了解的项目。'),lang)}</h2></div><div class="card-grid">{projects.map(p=><a class:list={['card',p.color]} href={url(lang,`projects/${p.id}`)}><span class="eyebrow">{t(p.role,lang)}</span><h3 style="margin-top:24px">{p.name}</h3><p>{t(p.description,lang)}</p><span class="text-link">{t(ui.learn,lang)}<Icon size={16}/></span></a>)}</div><aside class="notice"><strong>{t(ui.preview,lang)}</strong>{t(b('The connected walkthrough reflects the September 8 development integration. Published releases are listed separately, with their own capability baselines.', '互联流程演示反映 9 月 8 日开发集成。已发布版本单独列出，并保留各自的能力基线。'),lang)}</aside></section>
</>}

{slug === 'demo' && <section class="section container"><Workflow lang={lang}/><div class="section-header" style="margin-top:60px"><h2>{t(b('Try the real setup, one layer at a time.', '逐层尝试，建立真实环境。'),lang)}</h2><p>{t(b('The example is a guided interaction. To reproduce the workflow, begin with the setup guides and the matching development revisions. The permission card and delivery shown here are explanatory illustrations.', '此示例是引导式交互。若要复现流程，请从配置指南与匹配的开发版本开始。这里展示的权限卡片与文件交付均为解释性示意。'),lang)}</p></div><div class="card-grid">{guides.filter(g=>['connect-fleet','request-agent','approvals'].includes(g.slug)).map(g=><a class="card" href={url(lang,`docs/${g.slug}`)}><span class="eyebrow">{t(g.category,lang)}</span><h3 style="margin-top:24px">{t(g.title,lang)}</h3><p>{t(g.description,lang)}</p><span class="text-link">{t(ui.readGuide,lang)}<Icon size={16}/></span></a>)}</div></section>}

{slug === 'use-cases' && <section class="section container">{cases.map((item,i)=><article class="two-col use-case-row"><div class="prose"><span class="eyebrow">0{i+1} / {t(b('A WAY TO WORK', '一种工作方式'),lang)}</span><h2 style="margin-top:23px">{t(item.title,lang)}</h2><p>{t(item.body,lang)}</p><a class="text-link" href={url(lang,item.href)}>{t(ui.readGuide,lang)}<Icon size={16}/></a></div><div class="card"><span class="card-icon"><Icon name={item.icon} size={30}/></span><h3>{t(b('In practice', '实际场景'),lang)}</h3><p>{t(item.example,lang)}</p><ul class="plain-list">{item.points.map(point=><li><Icon name="check" size={15}/><span>{t(point,lang)}</span></li>)}</ul></div></article>)}<aside class="notice"><strong>{t(b('Evaluate the workflow you need', '评估你实际需要的流程'),lang)}</strong>{t(b('Integrated agent allocation, native approvals, and thread delivery refer to the development baseline. Start with a bounded evaluation and check the exact supported platform and runtime.', '集成的 Agent 分配、原生审批与线程交付均指开发基线。请从范围明确的评估开始，确认具体支持的平台与运行时。'),lang)}</aside></section>}

{slug === 'get-started' && <>
  <section class="section container"><div class="card-grid">{paths.map(path=><a class="card" href={url(lang,path.href)}><span class="card-icon"><Icon name={path.icon} size={28}/></span><h3>{t(path.title,lang)}</h3><p>{t(path.description,lang)}</p><span class="text-link">{t(path.label,lang)}<Icon size={16}/></span></a>)}</div><aside class="notice"><strong>{t(b('Start with a known version', '从明确的版本开始'),lang)}</strong>{t(b('Release packages are the published starting points. The full Hagency workflow requires matching development builds. Installing the three latest releases alone does not enable every integration feature shown on this site.', '发布安装包是已公开的起点。完整 Hagency 工作流程需要匹配的开发构建。仅安装三个最新发布版本，并不能启用本站展示的全部集成功能。'),lang)}</aside></section>
  <section class="section container border-top"><div class="section-header"><span class="eyebrow">{t(b('THE CONNECTED PATH', '完整的连接路径'),lang)}</span><h2>{t(b('Build up to your first task.', '逐步建立第一个任务。'),lang)}</h2></div><div class="timeline">{['choose-your-path','connect-fleet','request-agent','task-threads'].map((id,i)=>{const guide=guides.find(g=>g.slug===id)!;return <article class="timeline-item"><span class="eyebrow">0{i+1} / {t(guide.category,lang)}</span><h3>{t(guide.title,lang)}</h3><p>{t(guide.description,lang)}</p><a class="text-link" href={url(lang,`docs/${id}`)}>{t(ui.readGuide,lang)}<Icon size={16}/></a></article>})}</div></section>
</>}

{slug === 'docs' && <section class="section container"><div class="guide-topbar"><span class="eyebrow">{t(b('10 GUIDES / FROM SETUP TO OPERATIONS', '10 篇指南 / 从配置到运维'),lang)}</span><button class="inline-search search-open" type="button"><Icon name="search" size={17}/>{t(ui.searchPlaceholder,lang)}<kbd>⌘ K</kbd></button></div><div class="card-grid guide-grid">{guides.map((g,i)=><a class="card" href={url(lang,`docs/${g.slug}`)}><span class="card-number">{String(i+1).padStart(2,'0')}</span><span class="eyebrow">{t(g.category,lang)}</span><h3 style="margin-top:24px">{t(g.title,lang)}</h3><p>{t(g.description,lang)}</p><span class="text-link">{t(ui.readGuide,lang)}<Icon size={16}/></span></a>)}</div><aside class="notice"><strong>{t(b('Integration guides and upstream documentation', '集成指南与上游文档'),lang)}</strong>{t(b('These guides explain the relationships between the projects. Consult the linked upstream documentation for current installation details and prerequisites. Development-only workflows are identified in each guide.', '这些指南解释项目之间的协作关系。当前安装细节与依赖要求，请参阅链接的上游文档。各指南会标明仅适用于开发版本的流程。'),lang)}</aside></section>}

{slug === 'downloads' && <section class="section container"><div class="platform-control"><label for="platform">{t(ui.platform,lang)}</label><select id="platform" data-platform-select><option value="all">{t(ui.all,lang)}</option>{Object.entries(platformNames).filter(([key])=>!key.includes(',')).map(([key,value])=><option value={key}>{value}</option>)}</select><span class="eyebrow">{t(ui.lastVerified,lang)}</span></div>{releases.releases.map(release=>{const project=projects.find(p=>p.id===release.id)!;return <article class="release-group" data-release-group><div class="release-header"><div><h2>{project.name}<span>{release.tag}</span></h2><p>{t(ui.published,lang)} · {date(release.publishedAt)}</p></div><a class="text-link" href={release.source} target="_blank" rel="noopener noreferrer">{t(ui.releaseNotes,lang)}<Icon name="external" size={14}/></a></div>{release.assets.map(asset=><div class="download-row" data-download-row data-platform={asset.platform}><div><strong>{platformNames[asset.platform]} · {asset.arch}{release.id==='hafleet' && ` · ${t(asset.name.includes('remote') ? b('Remote component','远程组件') : b('Full runtime','完整运行时'),lang)}`}</strong><small>{asset.name} · {(asset.size/1048576).toFixed(1)} MB</small>{asset.signature && <a class="asset-signature" href={asset.signature}>{t(b('Signature','签名'),lang)}</a>}</div><a class="text-link" href={asset.url} aria-label={`${t(ui.download,lang)} ${asset.name}`}>{t(ui.download,lang)}<Icon name="download" size={16}/></a></div>)}<p class="platform-empty" data-platform-empty hidden>{t(b('This release does not include a binary for the selected platform. Consult the project’s source-build documentation.', '此版本未提供所选平台的二进制文件，请查阅项目源码构建文档。'),lang)} <a class="text-link" href={repos[project.id]}>{t(ui.source,lang)}<Icon name="external" size={13}/></a></p>{release.checksums && <div class="download-row"><span class="muted">SHA256</span><a class="text-link" href={release.checksums}>{t(b('Checksums','校验和'),lang)}<Icon name="download" size={14}/></a></div>}</article>})}<aside class="notice"><strong>{t(b('A release is a specific baseline', '每个发布版本都有明确基线'),lang)}</strong>{t(b('These links come from the projects’ GitHub release manifests. Robrix2 1.1.0 has no published iOS binary; iOS requires a source build. Palpo’s companion admin service is separate from its server package. Review prerequisites and signatures using the upstream instructions.', '这些链接来自项目的 GitHub 发布清单。Robrix2 1.1.0 未发布 iOS 二进制包，iOS 需要源码构建。Palpo 配套管理服务独立于服务器安装包。请按上游说明检查依赖和签名。'),lang)}</aside><div class="source-list">{projects.map(p=><a href={repos[p.id]} target="_blank" rel="noopener noreferrer">{p.name} / {t(ui.source,lang)}</a>)}</div></section>}

{slug === 'security' && <section class="section container"><div class="card-grid guide-grid">{trustSections.map((item,i)=><article class="card"><span class="eyebrow">0{i+1} / {t(b('TRUST & CONTROL','信任与控制'),lang)}</span><h3 style="margin-top:24px">{t(item.title,lang)}</h3>{item.paragraphs.map(p=><p>{t(p,lang)}</p>)}</article>)}</div><aside class="notice"><strong>{t(b('Check the exact deployment', '核验具体部署'),lang)}</strong>{t(b('These are documented design and implementation boundaries, not an independent security audit or certification. The supported operation depends on the selected runtime, platform, and revision.', '这些内容描述文档和实现中的边界，并非独立安全审计或认证。实际支持的操作取决于所选运行时、平台与版本。'),lang)}</aside><div class="button-row"><a class="button" href={url(lang,'docs/approvals')}>{t(b('Understand approvals','理解审批机制'),lang)}<Icon size={16}/></a><a class="button button-quiet" href={url(lang,'docs/operations')}>{t(b('Operations guide','运维指南'),lang)}<Icon size={16}/></a></div></section>}

{slug === 'updates' && <>
  <section class="section container"><div class="guide-topbar"><span class="eyebrow">{t(b('IDEAS & INTEGRATION STORIES', '理念与集成故事'),lang)}</span><a class="text-link" href={`/${lang}/rss.xml`}>RSS<Icon name="external" size={14}/></a></div><div class="card-grid">{articles.map(article=><a class="card article-card" href={url(lang,`updates/${article.slug}`)}><span class="eyebrow">{t(article.category,lang)}</span><h3>{t(article.title,lang)}</h3><p>{t(article.description,lang)}</p><div class="article-bottom"><span>{date(article.date!)}</span><Icon size={18}/></div></a>)}</div></section>
  <section class="section container border-top"><div class="section-header"><span class="eyebrow">{t(ui.lastVerified,lang)}</span><h2>{t(b('From the project repositories.', '来自项目仓库。'),lang)}</h2><p>{t(b('The latest published releases verified for this edition of the site. Follow each repository for subsequent development.', '本次网站内容核验的最新公开版本。后续开发进展，请关注各项目仓库。'),lang)}</p></div><div class="filters" data-filter-group aria-label={t(b('Filter releases by project','按项目筛选版本'),lang)}><button class="filter-button" data-filter="all" aria-pressed="true">{t(b('All projects','全部项目'),lang)}</button>{projects.map(p=><button class="filter-button" data-filter={p.id} aria-pressed="false">{p.name}</button>)}</div><div class="timeline">{releases.releases.map(release=>{const p=projects.find(p=>p.id===release.id)!;return <article class="timeline-item" data-filter-item={p.id}><span class="eyebrow">{date(release.publishedAt)} / {t(ui.published,lang)}</span><h3>{p.name} {release.tag}</h3><p>{t(p.short,lang)} · {release.assets.length} {t(b('downloadable packages','个可下载安装包'),lang)}</p><a class="text-link" href={release.source} target="_blank" rel="noopener noreferrer">{t(ui.releaseNotes,lang)}<Icon name="external" size={14}/></a></article>})}</div></section>
</>}

{slug === 'roadmap' && <section class="section container"><div class="card-grid">{roadmap.map(column=><article class:list={['card',column.color]}><span class="eyebrow">{t(column.state,lang)}</span><h3 style="margin-top:24px">{t(column.title,lang)}</h3><ul class="plain-list">{column.items.map(item=><li><Icon name="check" size={15}/><span>{t(item,lang)}</span></li>)}</ul><a class="text-link" href={url(lang,column.href)}>{t(column.link,lang)}<Icon size={16}/></a></article>)}</div><aside class="notice"><strong>{t(b('A transparent snapshot, not a dated promise', '透明的进展快照，不是交付日期承诺'),lang)}</strong>{t(b('Status is based on the source and integration evidence reviewed on September 8, 2026. Development work is not automatically part of a published package. Priorities and delivery dates remain with the individual projects.', '状态依据 2026 年 9 月 8 日核验的源码与集成证据。开发工作不会自动成为已发布安装包的一部分。优先级与交付日期由各项目自行维护。'),lang)}</aside><div class="section-header" style="margin-top:65px"><h2>{t(b('Follow the work where it happens.', '到工作发生的地方，跟进进展。'),lang)}</h2></div><div class="card-grid">{projects.map(p=><a class="card" href={`${repos[p.id]}/issues`} target="_blank" rel="noopener noreferrer"><span class="eyebrow">GitHub</span><h3 style="margin-top:24px">{p.name}</h3><p>{t(b('Explore open issues, implementation discussions, and opportunities to contribute.', '探索开放问题、实现讨论与贡献机会。'),lang)}</p><span class="text-link">{t(b('View project issues','查看项目问题'),lang)}<Icon name="external" size={15}/></span></a>)}</div></section>}

{slug === 'community' && <>
  <section class="section container"><div class="card-grid">{projects.map(p=><a class="card" href={repos[p.id]} target="_blank" rel="noopener noreferrer"><span class="eyebrow">{t(p.role,lang)}</span><h3 style="margin-top:24px">{p.name}</h3><p>{t(p.short,lang)}</p><span class="text-link">GitHub<Icon name="external" size={15}/></span></a>)}</div><div class="two-col" style="margin-top:65px"><div class="prose"><h2>{t(b('Bring a useful contribution.', '带来一份有价值的贡献。'),lang)}</h2><p>{t(b('Start with the repository you want to improve. Read its contribution instructions, discuss the scope in an issue, and submit a focused change with the relevant validation. Small, well-explained improvements make an open ecosystem stronger.', '从你希望改进的仓库开始。阅读贡献说明，在问题中讨论范围，并提交目标明确、附有相关验证的修改。细小而解释清楚的改进，也能让开放生态更加完善。'),lang)}</p><ul class="plain-list">{[b('Code: reproduce an issue and improve a specific path.', '代码：复现问题，改进具体流程。'),b('Documentation: test a guide on a real installation.', '文档：在真实安装中验证指南。'),b('Translation: keep English and Chinese meaning aligned.', '翻译：保持中英文含义一致。'),b('Design and accessibility: make the interface clearer.', '设计与无障碍：让界面更清晰易用。')].map(point=><li><Icon name="check" size={15}/><span>{t(point,lang)}</span></li>)}</ul></div><div class="card"><span class="card-icon"><Icon name="chat" size={30}/></span><h3>{t(b('Meet the Robius community.', '认识 Robius 社区。'),lang)}</h3><p>{t(b('Robrix builds on the broader Project Robius and Makepad ecosystem. Its public Matrix room is a place to follow the upstream client and meet people building native Rust applications.', 'Robrix 基于更广泛的 Project Robius 与 Makepad 生态。其公开 Matrix 房间是了解上游客户端、结识原生 Rust 应用开发者的地方。'),lang)}</p><a class="text-link" href="https://matrix.to/#/#robius-robrix:matrix.org" target="_blank" rel="noopener noreferrer">{t(b('Open the public Matrix room','打开公开 Matrix 房间'),lang)}<Icon name="external" size={15}/></a><p class="visual-caption" style="margin-top:25px">{t(b('An upstream community room; a Matrix account is required to participate.', '这是上游社区房间，参与交流需要 Matrix 账户。'),lang)}</p></div></div></section>
</>}

{slug === 'about' && <>
  <section class="section container"><p class="manifesto">{t(b('People bring intention. Agents bring capability. Open infrastructure gives both a place to work. ', '人带来意图，Agent 带来能力，开放基础设施为两者提供共同工作的空间。'),lang)}<em>{t(b('The direction stays human.', '方向，始终由人掌握。'),lang)}</em></p><div class="two-col" style="margin-top:70px"><div class="prose"><h2>{t(b('What Hagency brings together', 'Hagency 连接什么'),lang)}</h2><p>{t(b('Hagency presents a connected approach to human–agent collaboration through three open source projects. It makes the relationship between native conversation, agent execution, and Matrix infrastructure understandable, and offers practical paths into the work.', 'Hagency 通过三个开源项目，呈现互联的人机协作方式。它让原生对话、Agent 执行与 Matrix 基础设施之间的关系变得清晰，并提供参与实践的具体路径。'),lang)}</p></div><div class="prose"><h2>{t(b('Built with an open ecosystem', '与开放生态共同构建'),lang)}</h2><p>{t(b('The projects retain their own repositories, licenses, and communities. Robrix2 is a fork in the Project Robius / Makepad ecosystem. Palpo is an independent Matrix homeserver project. HAFleet connects coding runtimes with agent operations. Credit belongs to the people building these foundations.', '各项目保留自己的仓库、许可证与社区。Robrix2 是 Project Robius / Makepad 生态中的分支，Palpo 是独立的 Matrix 服务器项目，HAFleet 则将编程运行时与 Agent 运维连接起来。这些基础属于共同建设它们的贡献者。'),lang)}</p></div></div></section>
  <section class="section container border-top"><div class="section-header"><span class="eyebrow">{t(b('SOURCE & ATTRIBUTION', '源码与致谢'),lang)}</span><h2>{t(b('Open work has many authors.', '开放的工作，由许多人共同完成。'),lang)}</h2></div><div class="card-grid">{projects.map(p=><article class="card"><span class="eyebrow">{p.id==='robrix2'?'MIT':'Apache-2.0'}</span><h3 style="margin-top:24px">{p.name}</h3><p>{t(p.short,lang)}</p><a class="text-link" href={repos[p.id]} target="_blank" rel="noopener noreferrer">{t(b('Repository & contributors','仓库与贡献者'),lang)}<Icon name="external" size={15}/></a></article>)}</div><p class="visual-caption" style="margin-top:25px">{t(b('Geist typography by Vercel, under the SIL Open Font License. Original Hagency hero artwork generated for this website. Visual direction inspired by the operator-selected Adora website.', 'Geist 字体由 Vercel 提供，采用 SIL 开源字体许可证。Hagency 原创首屏插图为本站生成，视觉方向参考用户选定的 Adora 网站。'),lang)}</p></section>
</>}

