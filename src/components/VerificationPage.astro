---
import {b,t,url,type Locale} from '@/data/site';
import features from '@/data/capabilities.json';
interface Props {lang:Locale;compare?:boolean}
const {lang,compare=false}=Astro.props;
const rows=features.rows.filter(row=>compare?row.comparison:row.audience!=='comparison');
const availability={development:b('Development version','开发版'),'runtime-dependent':b('Runtime dependent','依运行时提供')};
---
<section class="page-hero"><div class="container"><span class="eyebrow">HAGENCY · {rows.length} {t(b('FEATURES','项功能'),lang)}</span><h1>{t(compare?b('Two ways to work with coding agents.','两种编程 Agent 协作方式。'):b('Coding agents, connected to your team.','让编程 Agent 融入团队协作。'),lang)}</h1><p>{t(compare?b('Hagency brings local coding runtimes, Matrix conversations and shared resource pools together. Buzz connects Nostr communities with coding harnesses, workflows and repository activity.','Hagency 将本地编程运行时、Matrix 对话与共享资源池连接起来。Buzz 将 Nostr 社区与编程 harness、工作流和仓库动态结合。'):b('Run Codex, Claude Code or Octos on your computer. Discuss tasks in Matrix, review tool permissions and keep progress and results in the conversation.','在自己的电脑上运行 Codex、Claude Code 或 Octos，通过 Matrix 讨论任务、审批工具权限，在对话中跟进进展与成果。'),lang)}</p><div class="button-row"><a class="button" href={url(lang,'docs/request-agent')}>{t(b('Create your first Agent','创建第一个 Agent'),lang)}</a><a class="button button-quiet" href={url(lang,compare?'capabilities':'compare')}>{t(compare?b('Explore Hagency features','了解 Hagency 功能'):b('Compare with Buzz','与 Buzz 比较'),lang)}</a></div></div></section>
<section class="section container verification" data-verification>
  {compare && <div class="two-col audit-summary"><article class="card"><h2>{t(b('Hagency: local execution, shared control','Hagency：本地执行，团队协作'),lang)}</h2><p>{t(b('Use Matrix rooms across your organization, choose local Octos model profiles, and share capacity through owner-approved resource pools. Keep runtime credentials on the execution computer.','使用 Matrix 房间连接团队，选择本地 Octos 模型配置，通过所有者审批的资源池共享容量。运行时凭据保留在执行电脑上。'),lang)}</p></article><article class="card"><h2>{t(b('Buzz: communities and automation','Buzz：社区与自动化'),lang)}</h2><p>{t(b('Organize Nostr community conversations, connect local coding harnesses and configure workflows through forms or YAML. Browse repository activity and keep Markdown pages with conversations.','组织 Nostr 社区对话，接入本地编程 harness，通过表单或 YAML 配置工作流。浏览仓库动态，并在对话中保存 Markdown 页面。'),lang)}</p></article></div>}
  <div class="audit-controls"><label for="feature-query">{t(b('Find a feature','查找功能'),lang)}<input id="feature-query" type="search" placeholder={t(b('e.g. Octos, pools, encryption','例如 Octos、资源池、加密'),lang)} data-audit-query/></label><label for="feature-category">{t(b('Category','功能分类'),lang)}<select id="feature-category" data-audit-filter>{Object.entries(features.groups).map(([value,label])=><option value={value}>{t(label,lang)}</option>)}</select></label><p data-audit-count role="status" aria-live="polite" data-suffix={t(b('features shown','项功能'),lang)}>{rows.length} {t(b('features shown','项功能'),lang)}</p></div>
  <p data-audit-empty hidden>{t(b('No matching features. Clear the search or choose All features.','没有匹配功能。请清空搜索或选择全部功能。'),lang)}</p>
  <div class="audit-rows">{rows.map(row=><article class="audit-row" data-audit-row data-category={row.category} id={row.id}>
    <div class="audit-row-heading"><h2><a href={"#"+row.id}>{t(row.name,lang)}</a></h2>{row.availability && <span class="eyebrow">{t(availability[row.availability as keyof typeof availability],lang)}</span>}</div>
    <dl class:list={['audit-products',{'with-buzz':compare}]}><div><dt>Hagency Desktop</dt><dd>{t(row.desktop,lang)}</dd></div><div><dt>Hagency Server</dt><dd>{t(row.server,lang)}</dd></div>{compare && <div><dt>Buzz</dt><dd>{t(row.buzz,lang)}</dd></div>}</dl>
    <p class="audit-boundary">{t(compare?row.comparisonNote:row.boundary,lang)}</p>
    <div class="audit-links"><a href={url(lang,"docs/"+row.guide)}>{t(b('Read the guide','阅读配置指南'),lang)} →</a></div>
  </article>)}</div>
  <details class="audit-pins"><summary>{t(b('Source code and versions','源码与版本'),lang)}</summary><ul>{Object.entries(features.pins).filter(([key])=>compare||key==='desktop'||key==='server').map(([key,pin])=><li><a href={"https://github.com/"+pin.repository+"/tree/"+pin.commit}>{key==='desktop'?'Hagency Desktop':key==='server'?'Hagency Server':key==='buzzApp'?'Buzz Desktop':'Buzz'}</a></li>)}</ul><p>{t(b('Get Desktop rc.14 from Downloads and follow its setup guide to connect a local runtime.','在下载页获取 Desktop rc.14，并按配置指南接入本地运行时。'),lang)}</p></details>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-verification]').forEach(root=>{
    const query=root.querySelector<HTMLInputElement>('[data-audit-query]')!;
    const filter=root.querySelector<HTMLSelectElement>('[data-audit-filter]')!;
    const rows=Array.from(root.querySelectorAll<HTMLElement>('[data-audit-row]'));
    const count=root.querySelector<HTMLElement>('[data-audit-count]')!;
    const empty=root.querySelector<HTMLElement>('[data-audit-empty]')!;
    const update=()=>{const term=query.value.trim().toLocaleLowerCase();let total=0;rows.forEach(row=>{row.hidden=!(row.textContent!.toLocaleLowerCase().includes(term)&&(filter.value==='all'||row.dataset.category===filter.value));if(!row.hidden)total++;});count.textContent=total+" "+count.dataset.suffix;empty.hidden=total!==0;};
    query.addEventListener('input',update);filter.addEventListener('change',update);
  });
</script>
<style>
  .audit-summary{margin-bottom:36px}.audit-controls{display:flex;align-items:end;gap:24px;flex-wrap:wrap;margin:32px 0}.audit-controls label{display:grid;gap:10px;flex:1;min-width:200px}.audit-controls input,.audit-controls select{font:inherit;min-height:48px;width:100%;padding:10px 14px;background:var(--bg-2);color:var(--text);border:1px solid var(--line);border-radius:8px}.audit-controls p{color:var(--muted);margin-bottom:12px}.audit-row{padding:32px 0;border-top:1px solid var(--line);scroll-margin-top:110px}.audit-row-heading{display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap}.audit-row-heading h2{font-size:24px;margin:0}.audit-products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin:24px 0}.audit-products.with-buzz{grid-template-columns:repeat(3,minmax(0,1fr))}.audit-products dt{font-weight:650;margin-bottom:8px}.audit-products dd{margin:0;color:var(--muted);line-height:1.7}.audit-boundary{border-left:2px solid var(--teal);padding-left:16px;line-height:1.7}.audit-links{display:flex;flex-wrap:wrap;gap:12px 24px;margin-top:18px}.audit-links a{color:var(--teal);text-decoration:underline;text-underline-offset:4px}.audit-pins{margin-top:40px;border-top:1px solid var(--line);padding-top:24px}.audit-pins summary{cursor:pointer;padding:12px 0}.audit-pins li{overflow-wrap:anywhere;margin:16px 0}@media(max-width:700px){.audit-products,.audit-products.with-buzz{grid-template-columns:1fr;gap:18px}.audit-row-heading h2{font-size:22px}.audit-controls{gap:16px}.audit-controls label{min-width:100%}}
</style>
