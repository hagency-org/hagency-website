---
import {b,t,url,type Locale} from '@/data/site';
import audit from '@/data/verification.json';
interface Props {lang:Locale;compare?:boolean}
const {lang,compare=false}=Astro.props;
const labels={all:b('All features','全部功能'),source:b('Source review','源码核验'),partial:b('Partial / unverified','部分完成 / 未验证'),'main-only':b('Main only','仅 main'),release:b('Release assets','发布资产'),'historical-jit':b('Historical JIT run','历史 JIT 测试'),'server-smoke':b('Server smoke scope','Server smoke 范围')};
---
<section class="page-hero"><div class="container"><span class="eyebrow">2026-11-19 · {audit.rows.length} {t(b('FEATURES','项功能'),lang)}</span><h1>{t(compare?b('Choose by the work you need.','根据要做的工作选择。'):b('What works, and where the limits are.','支持什么，边界在哪里。'),lang)}</h1><p>{t(compare?b('Hagency and Buzz both connect people and coding agents. Compare their current source contracts, available releases and acceptance gaps before choosing.','Hagency 和 Buzz 都连接人与编程 Agent。选择前，对照当前源码契约、发布可用性和验收缺口。'):b('A feature-by-feature audit of Hagency Desktop and Server. Published installers, main-branch changes and dated test evidence are kept distinct.','逐项核验 Hagency Desktop 与 Server，区分已发布安装包、main 新增能力与注明日期的测试证据。'),lang)}</p><div class="button-row"><a class="button" href={url(lang,'docs/request-agent')}>{t(b('Create your first Agent','创建第一个 Agent'),lang)}</a><a class="button button-quiet" href={url(lang,compare?'capabilities':'compare')}>{t(compare?b('Hagency capability audit','Hagency 能力核验'):b('Compare with Buzz','与 Buzz 比较'),lang)}</a></div></div></section>
<section class="section container verification" data-verification>
  {compare && <div class="two-col audit-summary"><article class="card"><h2>{t(b('Consider Hagency for','适合考虑 Hagency 的需求'),lang)}</h2><p>{t(b('Matrix conversations and federation, permanent Agent ownership, locally selected Octos profiles, and explicit resource-owner capacity decisions. Verify the deployment and chosen runtime.','Matrix 对话与联邦、永久 Agent 所有权、本地选择的 Octos 配置，以及由资源所有者明确决策的容量共享。需核验实际部署和选用运行时。'),lang)}</p></article><article class="card"><h2>{t(b('Consider Buzz for','适合考虑 Buzz 的需求'),lang)}</h2><p>{t(b('Documented YAML workflows, NIP-34 Git collaboration, canvases, voice huddles and broader harness choice. Buzz also has NIP-17 encrypted DMs.','已记录的 YAML 工作流、NIP-34 Git 协作、画布、语音 huddle 与更多 harness 选择；Buzz 也具备 NIP-17 加密私信。'),lang)}</p></article></div>}
  <aside class="notice"><strong>{t(b('Evidence boundary','证据边界'),lang)}</strong>{t(b('This is a pinned source comparison, not a matched live benchmark. Buzz native tasks and current Desktop core journeys have not all passed the same acceptance run. No overall winner or ≥90 UX claim is made from source review. Historical JIT results use a deterministic provider, not paid inference.','这是固定源码版本的对比，并非对等真实基准。Buzz 原生任务与当前 Desktop 核心流程尚未全部通过同一轮验收。源码核验不用于宣称整体胜出或 UX ≥90；历史 JIT 使用确定性提供方而非付费推理。'),lang)}</aside>
  <div class="audit-controls"><label for="feature-query">{t(b('Find a feature','查找功能'),lang)}<input id="feature-query" type="search" placeholder={t(b('e.g. Octos, pool, encryption','例如 Octos、资源池、加密'),lang)} data-audit-query/></label><label for="feature-evidence">{t(b('Evidence / availability','证据 / 可用性'),lang)}<select id="feature-evidence" data-audit-filter>{Object.entries(labels).map(([value,label])=><option value={value}>{t(label,lang)}</option>)}</select></label><p data-audit-count role="status" aria-live="polite" data-suffix={t(b('features shown','项功能'),lang)}>{audit.rows.length} {t(b('features shown','项功能'),lang)}</p></div>
  <p data-audit-empty hidden>{t(b('No matching features. Clear the search or choose All features.','没有匹配功能。请清空搜索或选择全部功能。'),lang)}</p>
  <div class="audit-rows">{audit.rows.map(row=><article class="audit-row" data-audit-row data-evidence={row.evidence} id={row.id}>
    <div class="audit-row-heading"><h2><a href={`#${row.id}`}>{t(row.name,lang)}</a></h2><span class="eyebrow">{t(labels[row.evidence as keyof typeof labels],lang)}</span></div>
    <dl class:list={['audit-products',{'with-buzz':compare}]}><div><dt>Hagency Desktop</dt><dd>{t(row.desktop,lang)}</dd></div><div><dt>Hagency Server</dt><dd>{t(row.server,lang)}</dd></div>{compare && <div><dt>Buzz</dt><dd>{t(row.buzz,lang)}</dd></div>}</dl>
    <p class="audit-boundary">{t(row.boundary,lang)}</p>
    <div class="audit-links"><a href={url(lang,`docs/${row.guide}`)}>{t(b('Setup / limits','配置 / 限制'),lang)} →</a>{row.sources.filter(s=>compare||s.product!=='buzzApp').map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.product==='buzzApp'?'Buzz':s.product==='desktop'?'Desktop':'Server'} · {t(b('source','源码'),lang)} ↗</a>)}</div>
  </article>)}</div>
  <details class="audit-pins"><summary>{t(b('Exact reviewed revisions','准确核验版本'),lang)}</summary><ul>{Object.entries(audit.pins).map(([key,pin])=><li><a href={`https://github.com/${pin.repository}/commit/${pin.commit}`}>{key}: <code>{pin.commit}</code></a></li>)}</ul><p>{t(b('The reviewed main is not the installed application. Desktop rc.13 uses source 5d9933a9; the reviewed Desktop main prepares rc.14.','核验的 main 不等于已安装应用。Desktop rc.13 使用源码 5d9933a9，核验的 Desktop main 正准备 rc.14。'),lang)}</p></details>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-verification]').forEach(root=>{
    const query=root.querySelector<HTMLInputElement>('[data-audit-query]')!;
    const filter=root.querySelector<HTMLSelectElement>('[data-audit-filter]')!;
    const rows=Array.from(root.querySelectorAll<HTMLElement>('[data-audit-row]'));
    const count=root.querySelector<HTMLElement>('[data-audit-count]')!;
    const empty=root.querySelector<HTMLElement>('[data-audit-empty]')!;
    const update=()=>{const term=query.value.trim().toLocaleLowerCase();let total=0;rows.forEach(row=>{row.hidden=!(row.textContent!.toLocaleLowerCase().includes(term)&&(filter.value==='all'||row.dataset.evidence===filter.value));if(!row.hidden)total++;});count.textContent=`${total} ${count.dataset.suffix}`;empty.hidden=total!==0;};
    query.addEventListener('input',update);filter.addEventListener('change',update);
  });
</script>
<style>
  .audit-summary{margin-bottom:36px}.audit-controls{display:flex;align-items:end;gap:24px;flex-wrap:wrap;margin:32px 0}.audit-controls label{display:grid;gap:10px;flex:1;min-width:200px}.audit-controls input,.audit-controls select{font:inherit;min-height:48px;width:100%;padding:10px 14px;background:var(--bg-2);color:var(--text);border:1px solid var(--line);border-radius:8px}.audit-controls p{color:var(--muted);margin-bottom:12px}.audit-row{padding:32px 0;border-top:1px solid var(--line);scroll-margin-top:110px}.audit-row-heading{display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap}.audit-row-heading h2{font-size:24px;margin:0}.audit-products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin:24px 0}.audit-products.with-buzz{grid-template-columns:repeat(3,minmax(0,1fr))}.audit-products dt{font-weight:650;margin-bottom:8px}.audit-products dd{margin:0;color:var(--muted);line-height:1.7}.audit-boundary{border-left:2px solid var(--teal);padding-left:16px;line-height:1.7}.audit-links{display:flex;flex-wrap:wrap;gap:12px 24px;margin-top:18px}.audit-links a{color:var(--teal);text-decoration:underline;text-underline-offset:4px}.audit-pins{margin-top:40px;border-top:1px solid var(--line);padding-top:24px}.audit-pins summary{cursor:pointer;padding:12px 0}.audit-pins li{overflow-wrap:anywhere;margin:16px 0}@media(max-width:700px){.audit-products,.audit-products.with-buzz{grid-template-columns:1fr;gap:18px}.audit-row-heading h2{font-size:22px}.audit-controls{gap:16px}.audit-controls label{min-width:100%}}
</style>
