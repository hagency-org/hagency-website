---
import { b,t,ui,url,type Locale } from '@/data/site';
import { guides,articles,type Article } from '@/data/content';
import Code from './Code.astro';
import Icon from './Icon.astro';
interface Props { lang: Locale; article: Article; kind: 'docs'|'updates' }
const { lang,article,kind } = Astro.props;
const related=(kind==='docs'?guides:articles).filter(a=>a.slug!==article.slug).slice(0,3);
---
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href={url(lang)}>Hagency</a><span>/</span><a href={url(lang,kind)}>{t(kind==='docs'?ui.docs:ui.updates,lang)}</a></div><span class="eyebrow" style="margin-top:30px">{t(article.category,lang)}</span><h1>{t(article.title,lang)}</h1><p>{t(article.description,lang)}</p><div class="article-meta"><span>{t(b('September 8, 2026','2026 年 9 月 8 日'),lang)}</span><span>{t(kind==='docs'?ui.guide:b('Hagency editorial','Hagency 编辑部'),lang)}</span></div></div></section>
<div class="section container article-layout"><article class="prose">{article.sections.map((section,i)=><section class="article-section" id={`section-${i+1}`}><h2>{t(section.title,lang)}</h2>{section.paragraphs.map(p=><p>{t(p,lang)}</p>)}{section.bullets&&<ul>{section.bullets.map(item=><li>{t(item,lang)}</li>)}</ul>}{section.code&&<Code code={section.code} lang={lang} label={t(b('Terminal','终端'),lang)} />}{section.link&&<p style="margin-top:23px"><a href={section.link.href} target="_blank" rel="noopener noreferrer">{t(section.link.label,lang)} ↗</a></p>}</section>)}{article.source&&<aside class="notice"><strong>{t(ui.sourceNotes,lang)}</strong><a href={article.source} target="_blank" rel="noopener noreferrer">{t(b('Consult the project’s current documentation','查阅项目当前文档'),lang)} ↗</a></aside>}{kind==='docs'&&<a class="text-link" href={url(lang,'docs')}>← {t(ui.allGuides,lang)}</a>}</article><aside class="article-aside"><span class="eyebrow">{t(ui.onThisPage,lang)}</span>{article.sections.map((section,i)=><a href={`#section-${i+1}`}>{t(section.title,lang)}</a>)}</aside></div>
<section class="section container border-top"><div class="section-header"><span class="eyebrow">{t(ui.related,lang)}</span><h2>{t(b('A useful next step.','继续前行的一步。'),lang)}</h2></div><div class="card-grid">{related.map(a=><a class="card guide-card" href={url(lang,`${kind}/${a.slug}`)}><span class="eyebrow">{t(a.category,lang)}</span><h3>{t(a.title,lang)}</h3><p>{t(a.description,lang)}</p><span class="text-link">{t(ui.readMore,lang)}<Icon size={16} /></span></a>)}</div></section>
