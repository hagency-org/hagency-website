---
import {t,type Locale,type Project} from '@/data/site';
import {projectScreenshots,screenshotUI} from '@/data/screenshots';
import ProjectScreenshot from './ProjectScreenshot.astro';
interface Props {lang:Locale;project:Project}
const {lang,project}=Astro.props;const shots=projectScreenshots(project.id);
---
{shots.length>0 && <section class="section container" id="screenshots"><div class="section-header"><span class="eyebrow">{t(screenshotUI.label,lang)}</span><h2>{t(screenshotUI.title,lang)}</h2><p>{t(screenshotUI.intro,lang)}</p></div><div class="screenshot-gallery">{shots.map(screenshot=><ProjectScreenshot lang={lang} screenshot={screenshot}/>)}</div></section>}
