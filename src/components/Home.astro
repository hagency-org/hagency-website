---
import { b, t, ui, home, projects, paths, faqs, url, type Locale } from '@/data/site';
import { articles } from '@/data/content';
import Icon from './Icon.astro';
import Architecture from './Architecture.astro';
import ProjectScreenshot from './ProjectScreenshot.astro';
import { projectScreenshots } from '@/data/screenshots';
import Workflow from './Workflow.astro';
import MatrixIntro from './MatrixIntro.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<section class="hero"><div class="hero-art" aria-hidden="true"></div><div class="hero-content"><span class="eyebrow"><span class="status-dot"></span>{t(home.eyebrow, lang)}</span><h1>Hagency</h1><p class="hero-subtitle">{t(home.subtitle, lang)}</p><p class="hero-description">{t(home.description, lang)}</p><div class="button-row"><a class="button" href={url(lang, 'get-started')}>{t(ui.start, lang)}<Icon size={17} /></a><a class="button button-quiet" href={url(lang, 'demo')}>{t(ui.explore, lang)}<Icon size={17} /></a></div><div class="hero-values">{home.values.map(value => <span>{t(value, lang)}</span>)}</div></div><div class="hero-bottom"><a class="hero-scroll" href="#ecosystem">{t(home.scroll, lang)}<Icon size={14} /></a><div class="hero-projects">{projects.map(p=><a href={url(lang, `projects/${p.id}`)}><span class:list={['project-dot', p.color]}></span>{p.name}</a>)}</div></div></section>
<section class="section container" id="ecosystem"><div class="intro-grid reveal"><div><span class="eyebrow">{t(home.introLabel, lang)}</span><h2>{t(home.introTitle, lang)}</h2></div><div><p>{t(home.introBody, lang)}</p><a class="text-link" href={url(lang, 'ecosystem')}>{t(ui.ecosystem, lang)}<Icon size={17} /></a></div></div><div class="reveal"><Architecture lang={lang} /></div></section>
<MatrixIntro lang={lang}/>
<section class="section container border-top" id="projects"><div class="section-header reveal"><span class="eyebrow">{t(home.projectsLabel, lang)}</span><h2>{t(ui.allProjects, lang)}</h2></div>{projects.map(project=><article class:list={['project-feature', project.color, 'reveal']}><div class="project-copy"><span class="eyebrow">{project.number} / {t(project.role, lang)}</span><h3>{project.name}</h3><h4>{t(project.headline, lang)}</h4><p>{t(project.description, lang)}</p><div class="technology-list">{project.technology.map(tag=><span>{tag === 'Desktop + mobile' ? t(b('Desktop + mobile','桌面与移动端'),lang) : tag}</span>)}</div><a class="text-link" href={url(lang, `projects/${project.id}`)}>{t(ui.learn, lang)}<Icon size={17} /></a></div><ProjectScreenshot screenshot={projectScreenshots(project.id)[0]} lang={lang} compact /></article>)}</section>
<section class="section container border-top" id="workflow"><div class="section-header reveal"><span class="eyebrow">{t(home.workflowLabel, lang)}</span><h2>{t(home.workflowTitle, lang)}</h2><p>{t(home.workflowBody, lang)}</p></div><Workflow lang={lang} /></section>
<section class="section principles"><div class="container"><div class="section-header reveal"><span class="eyebrow">{t(home.principlesLabel, lang)}</span><h2>{t(home.principlesTitle, lang)}</h2></div><div class="card-grid">{home.principles.map((principle,i)=><div class="card reveal"><span class="card-number">0{i+1}</span><span class="card-icon"><Icon name={principle.icon} size={28} /></span><h3>{t(principle.title, lang)}</h3><p>{t(principle.body, lang)}</p></div>)}</div><a class="text-link" style="margin-top:30px" href={url(lang, 'security')}>{t(b('Explore trust and control', '了解信任与控制'), lang)}<Icon size={17} /></a></div></section>
<section class="section container"><div class="section-header reveal"><span class="eyebrow">{t(home.pathLabel, lang)}</span><h2>{t(home.pathTitle, lang)}</h2></div><div class="card-grid">{paths.map(path=><a class="card reveal" href={url(lang,path.href)}><span class="card-icon"><Icon name={path.icon} size={28} /></span><h3>{t(path.title,lang)}</h3><p>{t(path.description,lang)}</p><span class="text-link">{t(path.label,lang)}<Icon size={17} /></span></a>)}</div></section>
<section class="section container border-top"><div class="section-header-row"><div class="section-header reveal"><span class="eyebrow">{t(home.updatesLabel,lang)}</span><h2>{t(home.updatesTitle,lang)}</h2></div><a class="text-link" href={url(lang,'updates')}>{t(ui.updates,lang)}<Icon size={17} /></a></div><div class="card-grid">{articles.map(article=><a class="card article-card reveal" href={url(lang,`updates/${article.slug}`)}><span class="eyebrow">{t(article.category,lang)}</span><h3>{t(article.title,lang)}</h3><p>{t(article.description,lang)}</p><div class="article-bottom"><span>{t(b('SEP 08, 2026','2026 年 9 月 8 日'),lang)}</span><Icon size={19} /></div></a>)}</div></section>
<section class="section container border-top"><div class="section-header"><span class="eyebrow">{t(b('A FEW GOOD QUESTIONS','几个值得了解的问题'),lang)}</span><h2>{t(b('Before you begin.','开始之前。'),lang)}</h2></div><div class="faq-list">{faqs.map(faq=><details class="faq-item"><summary>{t(faq.title,lang)}<Icon name="down" size={20} /></summary><p>{t(faq.body,lang)}</p></details>)}</div></section>
