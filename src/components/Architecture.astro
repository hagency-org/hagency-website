---
import { b, t, url, type Locale } from '@/data/site';
import Icon from './Icon.astro';
interface Props { lang: Locale; detailed?: boolean }
const { lang, detailed = false } = Astro.props;
const nodes = [
  {
    "id": "robrix2",
    "name": "Hagency Desktop",
    "color": "blue",
    "icon": "chat",
    "role": {
      "en": "CHAT + OWNER UI",
      "zh-cn": "聊天与所有者界面"
    },
    "desc": {
      "en": "Personal Agents, rooms and supported decisions.",
      "zh-cn": "个人 Agent、房间与支持的决策。"
    },
    "detail": {
      "en": "The native Makepad client hosts the local owner engine.",
      "zh-cn": "原生 Makepad 客户端托管本地所有者引擎。"
    }
  },
  {
    "id": "hagency",
    "name": "Hagency Server",
    "color": "amber",
    "icon": "network",
    "role": {
      "en": "ONE INTEGRATED SERVICE",
      "zh-cn": "一个集成服务"
    },
    "desc": {
      "en": "Palpo, Pasion and Agent management.",
      "zh-cn": "Palpo、Pasion 与 Agent 管理。"
    },
    "detail": {
      "en": "One Rust process; no separate Node companion or Fleet.",
      "zh-cn": "一个 Rust 进程，无需独立 Node 配套应用或 Fleet。"
    }
  },
  {
    "id": "robrix2",
    "name": "Codex · Claude · Octos",
    "color": "teal",
    "icon": "fleet",
    "role": {
      "en": "LOCAL EXECUTION",
      "zh-cn": "本地执行"
    },
    "desc": {
      "en": "Your chosen runtime, profile and model endpoint.",
      "zh-cn": "自行选择运行时、配置与模型入口。"
    },
    "detail": {
      "en": "Owner-controlled local credentials and supported tool policy.",
      "zh-cn": "由所有者控制的本地凭据与支持的工具策略。"
    }
  }
];
---
<div class:list={['architecture', { detailed }]}>
  <div class="architecture-overline"><span class="status-dot"></span>{t(b('A CONNECTED SYSTEM, WITH YOU IN IT', '一个有你参与的互联系统'), lang)}</div>
  <div class="architecture-nodes">
    {nodes.map((node, i) => <>
      {i > 0 && <div class="connection" aria-hidden="true"><span></span><span class="connection-label">{i === 1 ? 'Matrix' : 'Owner device'}</span><span></span></div>}
      <a class:list={['architecture-node', node.color]} href={url(lang, `projects/${node.id}`)}>
        <div class="node-orbit"><Icon name={node.icon} size={35} /><i></i><i></i></div>
        <span class="eyebrow">{t(node.role, lang)}</span><h3>{node.name}</h3><p>{t(node.desc, lang)}</p>
        {detailed && <p class="node-detail">{t(node.detail, lang)}</p>}
        <span class="node-arrow"><Icon size={19} /></span>
      </a>
    </>)}
  </div>
  <div class="architecture-under"><Icon name="people" size={17} /><span>{t(b('People set direction. Open protocols connect the work.', '人指引方向，开放协议连接工作。'), lang)}</span></div>
</div>

<a class="text-link" style="margin-top:24px" href={url(lang,'architecture')}>{t(b('Explore the complete architecture', '探索完整系统架构'),lang)}<Icon size={17}/></a>
