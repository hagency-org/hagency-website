---
import { b, t, ui, projects, repos, url, type Locale, type Project } from '@/data/site';
import Icon from './Icon.astro';
import Code from './Code.astro';
import ProjectVisual from './ProjectVisual.astro';
import ScreenshotGallery from './ScreenshotGallery.astro';
interface Props { lang: Locale; project: Project }
const { lang, project } = Astro.props;
const source = repos[project.id];
const guide = project.id === 'hafleet' ? 'run-hafleet' : project.id === 'robrix2' ? 'install-robrix2' : 'deploy-palpo';
---
<section class:list={['page-hero','project-page-hero',project.color]}><div class="container"><div class="breadcrumb"><a href={url(lang)}>Hagency</a><span>/</span><span>{project.name}</span></div><div class="project-lead-grid"><div><div class="project-title" style="margin-top:35px">{project.name} / {t(project.role,lang)}</div><h1>{t(project.headline,lang)}</h1><p>{t(project.description,lang)}</p><div class="button-row"><a class="button" href={url(lang,`docs/${guide}`)}>{t(ui.start,lang)}<Icon size={17} /></a><a class="button button-quiet" href={source} target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" size={15} /></a></div><div class="technology-list">{project.technology.map(tag=><span>{tag === 'Desktop + mobile' ? t(b('Desktop + mobile','桌面与移动端'),lang) : tag}</span>)}</div></div><ProjectVisual project={project} lang={lang} /></div></div></section>
<ScreenshotGallery lang={lang} project={project}/>
<section class="section container"><div class="section-header"><span class="eyebrow">{t(b('BUILT FOR THE WAY YOU WORK','为你的工作方式而构建'),lang)}</span><h2>{t(b('Capability, with a purpose.','每一种能力，都有明确的用途。'),lang)}</h2></div><div class="card-grid project-features">{project.features.map((feature,i)=><div class:list={['card',project.color,'reveal']}><span class="eyebrow">{String(i+1).padStart(2,'0')} / {project.name}</span><h3>{t(feature.title,lang)}</h3><p>{t(feature.body,lang)}</p></div>)}</div><aside class="notice"><strong>{t(ui.preview,lang)}</strong>{t(project.preview,lang)}</aside></section>
<section class="section container border-top"><div class="two-col"><div class="prose"><span class="eyebrow">{t(b('TAKE THE FIRST STEP','迈出第一步'),lang)}</span><h2 style="margin-top:20px">{t(b('Start with the source.\nOr choose a release.','从源码开始，\n或选择已发布版本。'),lang)}</h2><p>{t(b('Review the platform prerequisites and installation guide before running these commands. A source checkout follows development; release packages have their own documented baseline.','运行命令前，请阅读平台依赖和安装指南。源码检出跟随开发状态，发布安装包则有各自的文档基线。'),lang)}</p><a class="text-link" href={url(lang,'downloads')}>{t(ui.downloads,lang)}<Icon size={17} /></a></div><div><Code code={project.install} lang={lang} label={t(b('Source / installation preview','源码 / 安装预检查'),lang)} /><p class="visual-caption">{project.id === 'hafleet' ? t(b('Example: macOS dry run. The guide also covers Linux.','示例为 macOS 预检查，指南同时涵盖 Linux。'),lang) : t(b('Development source. Check upstream prerequisites.','开发源码，请先检查上游依赖要求。'),lang)}</p></div></div></section>
<section class="section container border-top"><div class="section-header"><span class="eyebrow">{t(ui.sourceNotes,lang)}</span><h2>{t(b('Know the version you’re exploring.','了解你正在探索的版本。'),lang)}</h2><p>{t(ui.lastVerified,lang)}.</p></div><div class="release-group"><div class="release-header"><div><h2>{project.name}<span>v{project.version}</span></h2><p>{t(ui.published,lang)} · {project.date}</p></div><a class="text-link" href={`${source}/releases/tag/v${project.version}`} target="_blank" rel="noopener noreferrer">{t(ui.releaseNotes,lang)}<Icon name="external" size={15} /></a></div><div class="download-row"><p class="muted">{t(b('Explore the latest code, documentation, and issues directly with the project.','直接进入项目，探索最新代码、文档与问题列表。'),lang)}</p><a class="text-link" href={source} target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" size={15} /></a></div></div><div class="source-list"><a href={`${source}/blob/${project.id === 'hafleet'?'master':'main'}/README.md`} target="_blank" rel="noopener noreferrer">README</a><a href={`${source}/issues`} target="_blank" rel="noopener noreferrer">{t(b('Project issues','项目问题'),lang)}</a><a href={url(lang,`docs/${guide}`)}>{t(ui.readGuide,lang)}</a></div></section>
<section class="section container border-top"><div class="section-header"><span class="eyebrow">{t(ui.ecosystemLabel,lang)}</span><h2>{t(b('Better, connected.','连接起来，发挥更多可能。'),lang)}</h2></div><div class="card-grid guide-grid">{projects.filter(p=>p.id!==project.id).map(p=><a class:list={['card',p.color]} href={url(lang,`projects/${p.id}`)}><span class="eyebrow">{t(p.role,lang)}</span><h3 style="margin-top:20px">{p.name}</h3><p>{t(p.description,lang)}</p><span class="text-link">{t(ui.learn,lang)}<Icon size={17} /></span></a>)}</div></section>
