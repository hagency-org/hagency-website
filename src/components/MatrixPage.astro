---
import { b, t, url, ui, type Locale } from '@/data/site';
import { matrix, matrixSources } from '@/data/matrix';
import Icon from './Icon.astro';
import MatrixNetwork from './MatrixNetwork.astro';
import RoomPermissions from './RoomPermissions.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<section class="page-hero matrix-page-hero"><div class="container"><div class="breadcrumb"><a href={url(lang)}>Hagency</a><span>/</span><span>Matrix</span></div><span class="eyebrow matrix-kicker">{t(b('THE OPEN PROTOCOL FOR CONVERSATION','面向对话的开放协议'),lang)}</span><h1>{t(matrix.title,lang)}</h1><p class="matrix-positioning">{t(matrix.positioning,lang)}</p><p>{t(matrix.introduction,lang)}</p><div class="button-row"><a class="button" href="#federation">{t(b('Explore federation','探索联邦互通'),lang)}<Icon size={17}/></a><a class="button button-quiet" href="#agent-native">{t(b('Meet agent-native collaboration','了解 Agent 原生协作'),lang)}<Icon size={17}/></a></div></div></section>

<section class="section container" id="protocol"><div class="section-header"><span class="eyebrow">{t(b('01 / WHAT IS MATRIX?', '01 / 什么是 MATRIX？'),lang)}</span><h2>{t(b('A common language for communication.', '让通信拥有共同语言。'),lang)}</h2><p>{t(b('Matrix defines how accounts, rooms, messages, and servers work together. Its open specification lets different implementations communicate. Hagency brings together a native client, a homeserver, and an agent runtime on that foundation.', 'Matrix 定义账户、房间、消息与服务器如何协作。开放规范让不同实现可以互相通信。Hagency 在这一基础上，将原生客户端、归属服务器与 Agent 运行时连接起来。'),lang)}</p><a class="text-link matrix-source" href={matrixSources.concepts} target="_blank" rel="noopener noreferrer">{t(b('Matrix concepts, from the Matrix project','Matrix 官方概念介绍'),lang)}<Icon name="external" size={13}/></a></div><div class="card-grid">{matrix.concepts.map(concept=><article class="card"><span class="card-icon"><Icon name={concept.icon} size={28}/></span><h3>{t(concept.title,lang)}</h3><p>{t(concept.body,lang)}</p></article>)}</div></section>

<section class="section container border-top" id="federation"><div class="section-header"><span class="eyebrow">{t(b('02 / FEDERATION', '02 / 联邦互通'),lang)}</span><h2>{t(matrix.federationTitle,lang)}</h2><p>{t(matrix.federationBody,lang)}</p></div><MatrixNetwork lang={lang}/><div class="source-list"><a href={matrixSources.protocol+'#room-structure'} target="_blank" rel="noopener noreferrer">{t(b('How Matrix rooms are shared','Matrix 如何共享房间'),lang)}</a><a href={matrixSources.federation} target="_blank" rel="noopener noreferrer">{t(b('Matrix federation specification','Matrix 联邦规范'),lang)}</a></div></section>

<section class="section matrix-comparison-section" id="why-open"><div class="container"><div class="section-header"><span class="eyebrow">{t(b('03 / WHY CHOOSE AN OPEN NETWORK?', '03 / 为什么选择开放网络？'),lang)}</span><h2>{t(b('More choice.\nLess dependence on one platform.', '更多选择，\n减少对单一平台的依赖。'),lang)}</h2><p>{t(b('For teams that value ownership, customization, and collaboration across organizations, federation changes who gets to make the decisions. Here is how the architecture differs from a typical closed, centralized chat service.', '对于重视自主掌控、定制能力与跨组织协作的团队，联邦互通改变了决策权的归属。以下是它与典型封闭式中心化聊天服务在架构上的区别。'),lang)}</p></div><table class="matrix-comparison"><caption class="sr-only">{t(b('Typical centralized chat compared with a federated Matrix network','典型中心化聊天服务与 Matrix 联邦网络比较'),lang)}</caption><thead><tr><th scope="col">{t(b('What matters','关注点'),lang)}</th><th scope="col">{t(b('Centralized chat','中心化聊天服务'),lang)}</th><th scope="col">{t(b('Federated Matrix','Matrix 联邦网络'),lang)}</th></tr></thead><tbody>{matrix.comparison.map(row=><tr><th scope="row">{t(row.topic,lang)}</th><td data-label={t(b('Centralized','中心化'),lang)}>{t(row.central,lang)}</td><td data-label={t(b('Federated Matrix','Matrix 联邦网络'),lang)}>{t(row.federated,lang)}</td></tr>)}</tbody></table><p class="comparison-context">{t(b('A comparison of deployment models, not a claim that every centralized service has the same features. A managed centralized service may be simpler to operate; Matrix gives you additional choices and corresponding responsibilities.', '此处比较部署模型，并不表示所有中心化服务的功能完全相同。托管的中心化服务可能更省心；Matrix 则提供更多选择，以及相应的责任。'),lang)}</p></div></section>

<section class="section container" id="agent-native"><div class="section-header"><span class="eyebrow">{t(b('04 / AGENT NATIVE', '04 / AGENT 原生'),lang)}</span><h2>{t(matrix.agentTitle,lang)}</h2><p>{t(matrix.agentBody,lang)}</p></div><RoomPermissions lang={lang}/><div class="two-col matrix-permission-context"><div class="prose"><h3>{t(b('A real identity in the conversation','对话中的真实身份'),lang)}</h3><p>{t(matrix.agentDetail,lang)}</p><a class="text-link matrix-source" href={matrixSources.agents} target="_blank" rel="noopener noreferrer">{t(b('Matrix application-service identities','Matrix 应用服务身份'),lang)}<Icon name="external" size={13}/></a></div><div class="prose"><h3>{t(b('Room authority and execution authority','房间权限与执行权限'),lang)}</h3><p>{t(matrix.permissionBoundary,lang)}</p><a class="text-link matrix-source" href={matrixSources.permissions} target="_blank" rel="noopener noreferrer">{t(b('Matrix room permission rules','Matrix 房间权限规则'),lang)}<Icon name="external" size={13}/></a></div></div><div class="button-row" style="margin-top:35px"><a class="button" href={url(lang,'demo')}>{t(ui.walkthrough,lang)}<Icon size={17}/></a><a class="button button-quiet" href={url(lang,'docs/approvals')}>{t(b('Understand execution approvals','理解执行审批'),lang)}<Icon size={17}/></a></div></section>

<section class="section container border-top" id="questions"><div class="section-header"><span class="eyebrow">{t(b('05 / A FEW IMPORTANT DISTINCTIONS','05 / 几个需要理解的区别'),lang)}</span><h2>{t(b('Understand the choices you’re making.', '理解你正在做出的选择。'),lang)}</h2></div><div class="faq-list">{matrix.faqs.map(faq=><details class="faq-item"><summary>{t(faq.question,lang)}<Icon name="down" size={20}/></summary><p>{t(faq.answer,lang)}</p></details>)}</div></section>
