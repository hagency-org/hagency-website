---
import { b, t, ui, url, projects, repos, type Locale } from '@/data/site';
import { guides, articles, pageInfo } from '@/data/content';
import Icon from '@/components/Icon.astro';
import Mark from '@/components/Mark.astro';
import ScreenshotViewer from '@/components/ScreenshotViewer.astro';
import '@/styles/global.css';
import '@/styles/matrix.css';
import '@/styles/screenshots.css';
interface Props { lang: Locale; slug?: string; title: string; description: string; noindex?: boolean }
const { lang, slug = '', title, description, noindex = false } = Astro.props;
const other = lang === 'en' ? 'zh-cn' : 'en';
const origin = Astro.site ?? new URL('http://localhost:4328');
const production = origin.protocol === 'https:';
const nav = [{ slug: 'ecosystem', label: ui.ecosystem }, { slug: 'matrix', label: ui.matrix }, { slug: 'use-cases', label: ui.useCases }, { slug: 'docs', label: ui.docs }, { slug: 'community', label: ui.community }];
const searchItems = [
  ...Object.entries(pageInfo).map(([route, value]) => ({ title: t(value.title, lang), description: t(value.description, lang), href: url(lang, route), type: t(b('Page', '页面'), lang) })),
  ...projects.map(p => ({ title: p.name, description: t(p.description, lang), href: url(lang, `projects/${p.id}`), type: t(ui.projects, lang) })),
  ...guides.map(g => ({ title: t(g.title, lang), description: t(g.description, lang), keywords: g.sections.map(s => `${t(s.title,lang)} ${s.paragraphs.map(p=>t(p,lang)).join(' ')}`).join(' '), href: url(lang, `docs/${g.slug}`), type: t(ui.guide, lang) })),
  ...articles.map(a => ({ title: t(a.title, lang), description: t(a.description, lang), keywords: a.sections.map(s => `${t(s.title,lang)} ${s.paragraphs.map(p=>t(p,lang)).join(' ')}`).join(' '), href: url(lang, `updates/${a.slug}`), type: t(ui.updates, lang) })),
];
---
<!doctype html>
<html lang={lang === 'zh-cn' ? 'zh-CN' : 'en'} data-theme="dark">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{slug ? `${title} — Hagency` : `Hagency — ${title}`}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0f" /><meta name="color-scheme" content="dark light" />
    {(!production || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/brand/hagency-mark.svg" />
    <link rel="canonical" href={new URL(url(lang, slug), origin).href} />
    <link rel="alternate" hreflang="en" href={new URL(url('en', slug), origin).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(url('zh-cn', slug), origin).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(url('en', slug), origin).href} />
    <link rel="alternate" type="application/rss+xml" title={`Hagency — ${t(ui.updates, lang)}`} href={`/${lang}/rss.xml`} />
    <meta property="og:type" content="website" /><meta property="og:site_name" content="Hagency" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(url(lang, slug), origin).href} /><meta property="og:image" content={new URL('/images/hagency-social.png', origin).href} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} /><meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/GeistVF.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try { const selected = localStorage.getItem('hagency-theme'); document.documentElement.dataset.theme = selected === 'light' || selected === 'dark' ? selected : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'); } catch { document.documentElement.dataset.theme = 'dark'; }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t(ui.skip, lang)}</a>
    <header class="site-header">
      <a class="brand" href={url(lang)} aria-label={t(b('Hagency home', 'Hagency 首页'), lang)}><Mark /><span>hagency<span class="brand-period">.</span></span></a>
      <nav class="desktop-nav" aria-label={t(b('Main navigation', '主导航'), lang)}>
        <details class="project-menu"><summary>{t(ui.projects, lang)}<Icon name="down" size={13} /></summary><div class="project-dropdown">{projects.map(p => <a href={url(lang, `projects/${p.id}`)}><span class:list={['project-dot', p.color]}></span><span><strong>{p.name}</strong><small>{t(p.short, lang)}</small></span><Icon size={15} /></a>)}</div></details>
        {nav.map(item => <a class:list={{ current: slug.startsWith(item.slug) }} href={url(lang, item.slug)}>{t(item.label, lang)}</a>)}
      </nav>
      <div class="header-actions"><button class="icon-button search-open" type="button" aria-label={t(ui.search, lang)}><Icon name="search" size={18} /></button><span class="header-divider"></span><a data-language-switch class="language-switch" href={url(other, slug)} lang={other === 'en' ? 'en' : 'zh-CN'} aria-label={t(ui.language, lang)}>{lang === 'en' ? '中文' : 'EN'}</a><button class="icon-button theme-toggle" type="button" aria-label={t(ui.theme, lang)}><Icon name="sun" size={18} class="theme-sun" /><Icon name="moon" size={18} class="theme-moon" /></button><a class="button button-small header-start" href={url(lang, 'get-started')}>{t(ui.start, lang)}<Icon size={14} /></a><button class="icon-button mobile-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label={t(ui.menu, lang)}><Icon name="menu" /></button></div>
    </header>
    <nav id="mobile-nav" class="mobile-nav" hidden aria-label={t(b('Mobile navigation', '移动端导航'), lang)}>
      {projects.map(p => <a href={url(lang, `projects/${p.id}`)}>{p.name}<Icon size={16} /></a>)}
      {nav.map(item => <a href={url(lang, item.slug)}>{t(item.label, lang)}<Icon size={16} /></a>)}
      <a href={url(lang, 'get-started')}>{t(ui.start, lang)}<Icon size={16} /></a>
    </nav>
    <main id="main"><slot /></main>
    <section class="closing-cta"><div class="closing-orbit" aria-hidden="true"></div><div class="container"><span class="eyebrow">HAGENCY</span><h2>{t(ui.learnTogether, lang)}</h2><p>{t(ui.ctaBody, lang)}</p><div class="button-row"><a class="button" href={url(lang, 'get-started')}>{t(ui.start, lang)}<Icon size={17} /></a><a class="button button-quiet" href={url(lang, 'community')}>{t(b('Join the community', '加入社区'), lang)}<Icon size={17} /></a></div></div></section>
    <footer class="site-footer container"><div class="footer-main"><div class="footer-brand"><a class="brand" href={url(lang)}><Mark /><span>hagency<span class="brand-period">.</span></span></a><p>{t(ui.footer, lang)}</p></div><div><span class="eyebrow">{t(ui.projects, lang)}</span>{projects.map(p => <a href={url(lang, `projects/${p.id}`)}>{p.name}</a>)}</div><div><span class="eyebrow">{t(ui.resources, lang)}</span>{[['matrix', ui.matrix], ['docs', ui.docs], ['downloads', ui.downloads], ['security', ui.security], ['updates', ui.updates]].map(([path, label]) => <a href={url(lang, path as string)}>{t(label as typeof ui.docs, lang)}</a>)}</div><div><span class="eyebrow">{t(ui.ecosystemLabel, lang)}</span>{[['community', ui.community], ['roadmap', ui.roadmap], ['about', ui.about], ['media', ui.media]].map(([path, label]) => <a href={url(lang, path as string)}>{t(label as typeof ui.docs, lang)}</a>)}</div></div><div class="footer-bottom"><p>{t(ui.footerNote, lang)}</p><a href={repos.hafleet} target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={12} /></a></div></footer>
    <dialog class="search-dialog" aria-labelledby="search-title" data-search-index={JSON.stringify(searchItems)} data-empty={t(ui.noResults, lang)}>
      <div class="search-dialog-top"><h2 id="search-title">{t(ui.search, lang)}</h2><button class="icon-button search-close" type="button" aria-label={t(ui.close, lang)}><Icon name="close" /></button></div>
      <label class="search-input-wrap"><Icon name="search" size={20} /><span class="sr-only">{t(ui.search, lang)}</span><input type="search" placeholder={t(ui.searchPlaceholder, lang)} autocomplete="off" /></label>
      <p class="search-hint">{t(ui.searchHint, lang)}</p><div class="search-results" aria-live="polite"></div><div class="search-bottom"><kbd>ESC</kbd><span>{t(ui.close, lang)}</span><span>⌘ / Ctrl + K</span></div>
    </dialog>
    <ScreenshotViewer lang={lang}/>
    <script>import '@/scripts/site';</script>
  </body>
</html>
